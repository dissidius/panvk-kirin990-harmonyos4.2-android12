#version 450
// GPU self-test 2: a 512-invocation workgroup (more than a Mali-G76 core
// holds, so the driver splits it) with shared memory, barriers and a
// module-level variable live across them, the pattern DXVK compute shaders
// use (Assassin's Creed IV hang, fixed in 1.2.8).
layout(local_size_x = 512) in;
layout(std430, binding = 0) writeonly buffer Out { uint res[]; };
shared uint s_arr[512];
uint mine;
void main() {
  uint lid = gl_LocalInvocationIndex;
  mine = lid * 7u + gl_WorkGroupID.x;
  s_arr[lid] = lid;
  barrier();
  uint nb = s_arr[511u - lid];
  barrier();
  res[gl_WorkGroupID.x * 512u + lid] = mine + nb;
}
