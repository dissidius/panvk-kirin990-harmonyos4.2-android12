From 887b8d1d237f27200646a5ae4675672a2cd430d8 Mon Sep 17 00:00:00 2001
From: soulexit <metehan.tanriverdi01@gmail.com>
Date: Tue, 10 Nov 2026 21:47:25 +0300
Subject: [PATCH 65/69] panvk/jm, libpan: keep the JM indirect varying buffer
 in the draw helper

The merge left the parts of upstream's poly_heap switch (a1ab82b2a76)
that did not conflict in draw_helper.cl, so indirect draws allocated
their varyings from an uninitialized poly_heap ("GPU heap overflow,
heap size 0"). Restore our draw helper and do not create poly_heap on
JM, which no longer uses it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/panfrost/libpan/draw_helper.cl    | 29 ++++++++++++++++++---------
 src/panfrost/vulkan/panvk_vX_device.c |  6 ++----
 2 files changed, 21 insertions(+), 14 deletions(-)

diff --git a/src/panfrost/libpan/draw_helper.cl b/src/panfrost/libpan/draw_helper.cl
index 5d338c27546..bf9e3328c49 100644
--- a/src/panfrost/libpan/draw_helper.cl
+++ b/src/panfrost/libpan/draw_helper.cl
@@ -14,7 +14,6 @@
 #include "draw_helper_vp.h"
 #include "tess_draw.h"
 #include "libpan_xfb.h"
-#include "poly/geometry.h"
 
 #if PAN_ARCH >= 9
 
@@ -1035,8 +1034,6 @@ struct panlib_draw_info {
 
    uint64_t position;
    uint64_t psiz;
-
-   global struct poly_heap *heap;
 };
 
 static void
@@ -1180,6 +1177,9 @@ panlib_patch_varying_bufs(struct panlib_draw_info *draw)
    uint32_t vertex_count = draw->padded_vertex_count * draw->instance.count;
 
    for (uint32_t i = 0; i < PANLIB_VARY_BUF_MAX; i++) {
+      global struct libpan_draw_helper_varying_buf_info *info =
+         &draw->varying_bufs.info[0];
+
       global struct mali_attribute_buffer_packed *desc =
          &draw->varying_bufs.descs[i];
       pan_unpack(desc, ATTRIBUTE_BUFFER, unpacked_desc)
@@ -1188,7 +1188,18 @@ panlib_patch_varying_bufs(struct panlib_draw_info *draw)
       pan_pack(desc, ATTRIBUTE_BUFFER, cfg) {
          memcpy(&cfg, &unpacked_desc, sizeof(cfg));
          cfg.size = vertex_count * cfg.stride;
-         cfg.pointer = (uint64_t) poly_heap_alloc(draw->heap, cfg.size, 64);
+
+         /* Ensure we are aligned properly */
+         uint32_t offset_add = ALIGN_POT(cfg.size, 64);
+
+         /* Allocate some space for ourself */
+         uint32_t current_offset = atomic_fetch_add_explicit(
+            &info->offset, offset_add, memory_order_relaxed);
+
+         /* Sanity check that we don't overrun the buffer */
+         assert(current_offset + cfg.size <= info->size);
+
+         cfg.pointer = info->address + current_offset;
 
          if (i == PANLIB_VARY_BUF_POSITION)
             draw->position = cfg.pointer;
@@ -1381,8 +1392,8 @@ padded_vertex_count(uint32_t vertex_count, uint32_t instance_count, bool idvs)
 static void
 draw_indirect_body(
    global VkDrawIndirectCommand *cmd,
-   global struct poly_heap *heap,
    global struct mali_attribute_buffer_packed *varying_bufs_descs,
+   global struct libpan_draw_helper_varying_buf_info *varying_bufs_info,
    global struct mali_attribute_buffer_packed *attrib_bufs_descs,
    global struct libpan_draw_helper_attrib_buf_info *attrib_bufs_infos,
    uint32_t attrib_bufs_valid, uint32_t attribs_valid,
@@ -1410,6 +1421,7 @@ draw_indirect_body(
       .instance.count = instance_count,
 
       .varying_bufs.descs = varying_bufs_descs,
+      .varying_bufs.info = varying_bufs_info,
 
       .attrib_bufs.descs = attrib_bufs_descs,
       .attrib_bufs.infos = attrib_bufs_infos,
@@ -1423,8 +1435,6 @@ draw_indirect_body(
       .padded_vertex_count =
          padded_vertex_count(vertex_count, instance_count, idvs_job != NULL),
       .primitive_vertex_count = primitive_vertex_count,
-
-      .heap = heap,
    };
 
    panlib_patch_draw(&draw);
@@ -1463,8 +1473,8 @@ draw_indexed_indirect_body(
    uint32_t min_vertex, uint32_t max_vertex,
    uint32_t index_size, uint32_t primitive_vertex_count,
    uint32_t attrib_bufs_valid, uint32_t attribs_valid,
-   global struct poly_heap *heap,
    global struct mali_attribute_buffer_packed *varying_bufs_descs,
+   global struct libpan_draw_helper_varying_buf_info *varying_bufs_info,
    global struct mali_attribute_buffer_packed *attrib_bufs_descs,
    global struct libpan_draw_helper_attrib_buf_info *attrib_bufs_infos,
    global struct mali_attribute_packed *attribs_descs,
@@ -1494,6 +1504,7 @@ draw_indexed_indirect_body(
       .instance.count = instance_count,
 
       .varying_bufs.descs = varying_bufs_descs,
+      .varying_bufs.info = varying_bufs_info,
 
       .attrib_bufs.descs = attrib_bufs_descs,
       .attrib_bufs.infos = attrib_bufs_infos,
@@ -1508,8 +1519,6 @@ draw_indexed_indirect_body(
          padded_vertex_count(vertex_range, instance_count, idvs_job != NULL),
       .primitive_vertex_count = primitive_vertex_count,
       .indices = index_buffer_ptr,
-
-      .heap = heap,
    };
 
    panlib_patch_draw(&draw);
diff --git a/src/panfrost/vulkan/panvk_vX_device.c b/src/panfrost/vulkan/panvk_vX_device.c
index 55ebf94cce3..15a83b9041e 100644
--- a/src/panfrost/vulkan/panvk_vX_device.c
+++ b/src/panfrost/vulkan/panvk_vX_device.c
@@ -1165,11 +1165,9 @@ panvk_per_arch(create_device)(struct panvk_physical_device *physical_device,
 
 #if PAN_ARCH >= 10
    simple_mtx_init(&device->poly_heap.init_lock, mtx_plain);
-#else
-   result = panvk_per_arch(device_init_poly_heap)(device);
-   if (result != VK_SUCCESS)
-      goto err_free_priv_bos;
 #endif
+   /* JM keeps its own indirect varying buffer (indirect_varying_buffer) and
+    * does not use poly_heap. */
 
 #if PAN_ARCH >= 10
    result = panvk_per_arch(init_tiler_oom)(device);
-- 
2.43.0

