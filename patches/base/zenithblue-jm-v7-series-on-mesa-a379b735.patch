index 00000000000..bb884c9be72
--- /dev/null
+++ b/src/panfrost/vulkan/bc/panvk_bc_rgtc.comp
@@ -0,0 +1,195 @@
+#version 450
+#extension GL_EXT_buffer_reference : require
+#extension GL_EXT_buffer_reference_uvec2 : require
+
+#ifdef PANVK_BC_FS
+/* Fragment variant (-DPANVK_BC_FS -S frag): decode into a colour attachment. */
+layout(location = 0) out vec4 o_color;
+#else
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
+#endif
+
+layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer InBuf {
+    uint data[];
+};
+
+layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer OutBuf {
+    uint data[];
+};
+
+layout(push_constant) uniform Registers
+{
+    uvec2 src;
+    uvec2 dst;
+    uint src_row_B;
+    uint src_slice_B;
+    uint dst_row_B;
+    uint dst_slice_B;
+    int width;
+    int height;
+    int depth;
+    int format;
+    int x0;
+    int y0;
+} registers;
+
+/* Copyright (c) 2020-2024 Hans-Kristian Arntzen
