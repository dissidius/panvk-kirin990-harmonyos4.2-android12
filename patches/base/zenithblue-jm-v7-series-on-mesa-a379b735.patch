diff --git a/src/panfrost/libpan/tess_draw.h b/src/panfrost/libpan/tess_draw.h
new file mode 100644
index 00000000000..a7db5098eb0
--- /dev/null
+++ b/src/panfrost/libpan/tess_draw.h
@@ -0,0 +1,158 @@
+/*
+ * Copyright 2026 Abhay Byte
+ * SPDX-License-Identifier: MIT
+ */
+
+#pragma once
+
+#include "compiler/libcl/libcl.h"
+#include "compiler/shader_enums.h"
+#include "poly/geometry.h"
+#include "poly/tessellator.h"
+
+/* Per-draw tessellation state shared by the CS loop and the panlib_tess_*
+ * kernels. Each loop iteration either starts a new chunk of patches (VS, TCS,
+ * tessellator) or draws the next index range of the current chunk.
+ */
+struct panlib_tess_draw {
+   struct poly_tess_params p;
+   struct poly_heap heap;
+
+   /* Vk[Indexed]DrawIndirectCommand of the API draw. */
+   uint32_t in_draw[5];
+   /* The part of the API draw the VS runs over for the current chunk. */
+   uint32_t vs_draw[5];
+   uint32_t tcs_grid[3];
+   /* Indexed draw of this iteration's range of tessellator indices. */
+   uint32_t draw[5];
+
+   uint32_t input_patch_size;
+   uint32_t max_patches;
+   uint32_t indexed;
+   /* Max indices drawn per iteration, 0 for a whole chunk. */
+   uint32_t range;
+   /* Vertices per output primitive. */
+   uint32_t verts_per_prim;
+
+   uint32_t patches_per_instance;
+   uint32_t instances;
+   uint32_t new_chunk;
+   uint32_t chunk_patches;
+   /* First patch of the chunk within its instance, the primitive ID base. */
+   uint32_t prim_base;
+   uint32_t idx_total;
+   uint32_t idx_cursor;
+   /* Output primitives drawn before this iteration, GS primitive ID base. */
+   uint32_t gs_prim_base;
+   uint32_t prims_done;
+   uint32_t more;
+   /* Chunk start within the API draw, see panvk_gpu_prerast_params. */
+   uint32_t chunk_vertex;
+   uint32_t chunk_instance;
+   /* v9 JM, unused (0) elsewhere: index budget of a chunk. panlib_tess_draw() keeps
+    * the longest run of the chunk's patches whose indices fit it (at least
+    * one patch) and hands the rest back to the next chunk. */
+   uint32_t idx_limit;
+
+   uint64_t total_patches;
+   uint64_t next_patch;
+#if defined(PAN_ARCH) && PAN_ARCH == 9
+   /* TCS patches statistic, counted by panlib_tess_draw() with idx_limit. */
+   uint64_t tcs_stat;
+#endif
+} PACKED;
+
+/* Vertex stride of a chunk window and what it shares with the next one, for
+ * the topologies whose chunks can be cut by vertex range: whole primitives
+ * (align), strip vertices repeated by the next chunk (overlap) and vertices
+ * per primitive start (div).
+ */
+static inline void
+panlib_chunk_topology(uint32_t prim, uint32_t *align, uint32_t *overlap,
+                      uint32_t *div)
+{
+   *align = 1;
+   *overlap = 0;
+   *div = 1;
+
+   switch (prim) {
+   case MESA_PRIM_LINES:
+      *align = *div = 2;
+      break;
+   case MESA_PRIM_TRIANGLES:
+      *align = *div = 3;
+      break;
+   case MESA_PRIM_LINES_ADJACENCY:
+      *align = *div = 4;
+      break;
+   case MESA_PRIM_TRIANGLES_ADJACENCY:
+      *align = *div = 6;
+      break;
+   case MESA_PRIM_LINE_STRIP:
+      *overlap = 1;
+      break;
+   case MESA_PRIM_LINE_STRIP_ADJACENCY:
+      *overlap = 3;
+      break;
+   case MESA_PRIM_TRIANGLE_STRIP:
+      *align = *overlap = 2;
+      break;
+   case MESA_PRIM_TRIANGLE_STRIP_ADJACENCY:
+      *align = 2;
+      *overlap = 4;
+      *div = 2;
+      break;
+   default:
+      break;
+   }
+}
+
+/* State of a non-tessellated gpu_prerast draw that the CS loop runs in
+ * chunks, see panlib_chunk_setup/step. The first part is written at record
+ * time, the rest by the kernels on every execution.
+ */
+/* The lowering kernels run one workgroup per (vertex, instance): the G615
+ * loses the device on grids with thousands of instances (4 x 8192 hangs, 4 x
+ * 4000 works), so a chunk holds no more.
+ */
+#define PANLIB_CHUNK_MAX_INSTANCES 2048u
+
+struct panlib_chunk_draw {
+   uint64_t index_buffer;
+   /* 0 when the primitives generated query is not counted here. */
+   uint64_t prims_generated;
+
+   uint32_t indexed;
+   uint32_t max_verts;
+   uint32_t prim;
+   /* Strip topology with primitive restart. */
+   uint32_t restart;
+   uint32_t index_size;
+   uint32_t index_count_el;
+   uint32_t view_count;
+
+   /* Vk[Indexed]DrawIndirectCommand of the API draw, and of this chunk. */
+   uint32_t in_draw[5];
+   uint32_t draw[5];
+
+   uint32_t next_inst;
+   uint32_t next_vertex;
+   uint32_t prims_done;
+   /* Primitives before this chunk within its instance, GS primitive ID base. */
+   uint32_t prim_base;
+   uint32_t more;
+   /* Chunk start within the API draw, see panvk_gpu_prerast_params. */
+   uint32_t chunk_vertex;
+   uint32_t chunk_instance;
+   /* Copy of "more" stored by the compute CS for the vertex/tiler CS. */
+   uint32_t more_vt;
+   /* Instances per chunk, 0 for PANLIB_CHUNK_MAX_INSTANCES. v9 JM, which
+    * lowered whole draws before, keeps whole instance ranges. */
+   uint32_t max_insts;
+#if defined(PAN_ARCH) && PAN_ARCH == 9
+   /* v9 JM: a strip window whose last restart index comes in
+    * its first half cuts the strip after it instead, so that every window
+    * moves on by at least half a step and the CPU can bound the chunks. */
+   uint32_t cut_tail;
+#endif
+} PACKED;
diff --git a/src/panfrost/libpan/tess_fast.cl b/src/panfrost/libpan/tess_fast.cl
new file mode 100644
index 00000000000..4b258936d31
--- /dev/null
+++ b/src/panfrost/libpan/tess_fast.cl
@@ -0,0 +1,266 @@
+/*
+ * Copyright 2026 Abhay Byte
+ * SPDX-License-Identifier: MIT
+ */
+
+/* CSF tessellation fast paths (csf-v11 tess perf). The kernels here replace
+ * passes of the draw_helper.cl tessellation loop, which stays as it is for
+ * the v9 JM path and for the PANVK_TESS_* knobs that turn these off.
+ */
+
+#include "compiler/libcl/libcl.h"
+#include "compiler/libcl/libcl_vk.h"
+#include "compiler/shader_enums.h"
+#include "poly/cl/tessellator.h"
+#include "tess_draw.h"
+
+#if PAN_ARCH >= 10
+
+/* pstats_add() of draw_helper.cl: a 64-bit add from 32-bit atomics. */
+static inline void
+tess_pstats_add(global uint32_t *counter, uint64_t value)
+{
+   uint32_t lo = value, hi = value >> 32;
+
+   if (!value)
+      return;
+
+   uint32_t old = atomic_fetch_add((global atomic_uint *)counter, lo);
+   hi += (uint32_t)(old + lo) < old;
+   if (hi)
+      atomic_fetch_add((global atomic_uint *)(counter + 1), hi);
+}
+
+/* One patch, as panlib_tessellate() does it. domain: 0 triangles, 1 quads,
+ * 2 isolines.
+ */
+static inline void
+tess_fast_patch(constant struct poly_tess_params *p, uint32_t domain,
+                uint32_t patch, enum poly_tess_mode mode)
+{
+   if (domain == 0)
+      poly_tess_tri_process(p, patch, mode);
+   else if (domain == 1)
+      poly_tess_quad_process(p, patch, mode);
+   else
+      poly_tess_isoline_process(p, patch, mode);
+
+   /* The tessellator emits clockwise triangles, swap two vertices of each
+    * one for the other winding. With POLY_TESS_CCW_INLINE (csf-v11
+    * tess-winding) the tessellator already wrote them swapped.
+    */
+   if (mode == POLY_TESS_MODE_WITH_COUNTS && (p->ccw & 1) && domain != 2 &&
+       !p->points_mode) {
+      global uint32_t *idx = p->index_buffer;
+      uint32_t end = p->counts[patch];
+
+      for (uint32_t i = patch ? p->counts[patch - 1] : 0; i + 2 < end;
+           i += 3) {
+         uint32_t tmp = idx[i + 1];
+         idx[i + 1] = idx[i + 2];
+         idx[i + 2] = tmp;
+      }
+   }
+}
+
+/* panlib_tessellate(WITH_COUNTS): one invocation per patch of the chunk. */
+KERNEL(64)
+panlib_tess_gen(constant struct poly_tess_params *p, uint32_t domain__3)
+{
+   uint32_t patch = cl_global_id.x;
+
+   if (patch < p->nr_patches)
+      tess_fast_patch(p, domain__3, patch, POLY_TESS_MODE_WITH_COUNTS);
+}
+
+/* csf-v11 tess-fused: panlib_tessellate(COUNT) and panlib_tess_draw() in one
+ * workgroup, with a parallel prefix sum instead of the serial loop. Each
+ * invocation counts a run of patches and sums it, a workgroup scan gives each
+ * run its start, then invocation 0 writes the draw as panlib_tess_draw()
+ * does. With gen set, the same workgroup also runs the WITH_COUNTS pass, so
+ * a small chunk takes one dispatch instead of three. p is &t->p.
+ *
+ * gen is a variant (csf-v11 tess-fuse-stack): the COUNT-only one inlines a
+ * single tessellator and keeps the stack of panlib_tessellate(COUNT). The
+ * gen variant inlines two tessellator contexts; for quads that is a 5.2 KiB
+ * stack (8 KiB per thread), which the driver does not run (see
+ * gpu_prerast_tess()).
+ */
+#define TESS_FUSE_WG 64
+
+KERNEL(TESS_FUSE_WG)
+panlib_tess_count_draw(global struct panlib_tess_draw *t,
+                       constant struct poly_tess_params *p,
+                       global uint32_t *c_invs, global uint32_t *c_prims,
+                       global uint32_t *prims_generated, uint32_t gen__2,
+                       uint32_t domain__3)
+{
+   local uint32_t scan[TESS_FUSE_WG];
+   const uint32_t tid = cl_local_id.x;
+   /* Read by every invocation before invocation 0 updates t below. */
+   const uint32_t new_chunk = t->new_chunk;
+   uint32_t total = 0;
+
+   if (new_chunk) {
+      const uint32_t n = p->nr_patches;
+      const uint32_t seg = (n + TESS_FUSE_WG - 1) / TESS_FUSE_WG;
+      const uint32_t b = min(tid * seg, n), e = min(b + seg, n);
+      uint32_t own = 0;
+
+      for (uint32_t i = b; i < e; i++) {
+         tess_fast_patch(p, domain__3, i, POLY_TESS_MODE_COUNT);
+         own += p->counts[i];
+         p->counts[i] = own;
+      }
+
+      /* Inclusive scan of the run sums. */
+      scan[tid] = own;
+      barrier(CLK_LOCAL_MEM_FENCE);
+      for (uint32_t o = 1; o < TESS_FUSE_WG; o <<= 1) {
+         uint32_t v = tid >= o ? scan[tid - o] : 0;
+         barrier(CLK_LOCAL_MEM_FENCE);
+         scan[tid] += v;
+         barrier(CLK_LOCAL_MEM_FENCE);
+      }
+
+      const uint32_t base = scan[tid] - own;
+      for (uint32_t i = b; i < e; i++)
+         p->counts[i] += base;
+      total = scan[TESS_FUSE_WG - 1];
+
+      /* WITH_COUNTS reads the prefix of the patch before its own. */
+      barrier(CLK_GLOBAL_MEM_FENCE | CLK_LOCAL_MEM_FENCE);
+      if (gen__2) {
+         for (uint32_t i = tid; i < n; i += TESS_FUSE_WG)
+            tess_fast_patch(p, domain__3, i, POLY_TESS_MODE_WITH_COUNTS);
+      }
+   }
+
+   if (tid != 0)
+      return;
+
+   const uint32_t vpp = max(t->verts_per_prim, 1u);
+
+   if (new_chunk) {
+      t->idx_total = total;
+      t->idx_cursor = 0;
+      if (c_invs)
+         tess_pstats_add(c_invs, total / vpp);
+      if (c_prims)
+         tess_pstats_add(c_prims, total / vpp);
+   }
+
+   uint32_t left = t->idx_total - t->idx_cursor;
+   uint32_t count = t->range ? min(t->range, left) : left;
+
+   t->draw[0] = count;
+   t->draw[1] = 1;
+   t->draw[2] = t->idx_cursor;
+   t->draw[3] = 0;
+   t->draw[4] = 0;
+
+   t->idx_cursor += count;
+   t->gs_prim_base = t->prims_done;
+   t->prims_done += count / vpp;
+   t->more = t->idx_cursor < t->idx_total || t->next_patch < t->total_patches;
+
+   if (prims_generated)
+      atomic_fetch_add((global atomic_uint *)prims_generated, count / vpp);
+}
+
+/* csf-v11 tess-setup-step: panlib_tess_setup(), the conditional rendering
+ * drop of the first iteration (recorded as CS loads and stores before) and
+ * panlib_tess_step() in one dispatch. pass[0] is the predicate (0 drops the
+ * draw), pass[1] the once-only flag; the CS writes both at execution time.
+ * The setup and step bodies are those of the draw_helper.cl kernels.
+ */
+KERNEL(1)
+panlib_tess_setup_step(global struct panlib_tess_draw *t,
+                       global uint32_t *tcs_stat, constant uint32_t *src_draw,
+                       constant uint32_t *count_buffer, uint32_t draw_index,
+                       global uint32_t *pass)
+{
+   global struct poly_tess_params *p = &t->p;
+   uint32_t ps = max(t->input_patch_size, 1u);
+
+   if (!pass[1]) {
+      bool live = !count_buffer || draw_index < count_buffer[0];
+
+      /* VkDrawIndirectCommand is 4 words. */
+      for (uint32_t i = 0; i < 5; i++)
+         t->in_draw[i] = live && (i < 4 || t->indexed) ? src_draw[i] : 0;
+
+      t->patches_per_instance = t->in_draw[0] / ps;
+      t->instances = t->in_draw[1];
+      t->total_patches = (uint64_t)t->patches_per_instance * t->instances;
+      t->next_patch = 0;
+      t->idx_total = 0;
+      t->idx_cursor = 0;
+      t->prims_done = 0;
+      t->new_chunk = 0;
+      t->more = 0;
+
+      /* What the CS once-block zeroed: every iteration is then an empty
+       * handshake. */
+      if (!pass[0]) {
+         t->in_draw[0] = 0;
+         t->in_draw[1] = 0;
+         t->patches_per_instance = 0;
+         t->instances = 0;
+         t->total_patches = 0;
+      }
+      pass[1] = 1;
+   }
+
+   t->new_chunk = t->idx_cursor >= t->idx_total && t->next_patch < t->total_patches;
+   if (!t->new_chunk) {
+      t->vs_draw[0] = 0;
+      t->vs_draw[1] = 0;
+      t->tcs_grid[0] = 0;
+      t->tcs_grid[1] = 0;
+      t->tcs_grid[2] = 0;
+      p->nr_patches = 0;
+      return;
+   }
+
+   uint32_t ppi = t->patches_per_instance;
+   uint32_t inst = t->next_patch / ppi;
+   uint32_t first = t->next_patch % ppi;
+   uint32_t per_inst, k;
+
+   if (first == 0 && ppi <= t->max_patches) {
+      per_inst = ppi;
+      k = min(t->max_patches / ppi, t->instances - inst);
+      k = min(k, PANLIB_CHUNK_MAX_INSTANCES);
+   } else {
+      per_inst = min(t->max_patches, ppi - first);
+      k = 1;
+   }
+
+   uint32_t n = per_inst * k;
+   p->patches_per_instance = per_inst;
+   p->nr_patches = n;
+   p->heap->bottom = 0;
+   t->chunk_patches = n;
+   t->prim_base = first;
+   t->next_patch += n;
+
+   /* Base vertex/instance stay the API ones, the chunk start is added to the
+    * VS invocation IDs.
+    */
+   t->vs_draw[0] = per_inst * ps;
+   t->vs_draw[1] = k;
+   for (uint32_t i = 2; i < 5; i++)
+      t->vs_draw[i] = t->in_draw[i];
+   t->chunk_vertex = first * ps;
+   t->chunk_instance = inst;
+
+   t->tcs_grid[0] = per_inst;
+   t->tcs_grid[1] = k;
+   t->tcs_grid[2] = 1;
+
+   if (tcs_stat)
+      tess_pstats_add(tcs_stat, n);
+}
+
+#endif
diff --git a/src/panfrost/libpan/tessellation.cl b/src/panfrost/libpan/tessellation.cl
new file mode 100644
index 00000000000..8da4f067296
--- /dev/null
+++ b/src/panfrost/libpan/tessellation.cl
@@ -0,0 +1,99 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "compiler/libcl/libcl.h"
+#include "compiler/libcl/libcl_vk.h"
+#include "poly/geometry.h"
+#include "poly/cl/tessellator.h"
+
+#if PAN_ARCH >= 6
+
+/*
+ * Mali does not expose fixed-function tessellation.  These kernels are the
+ * hardware-independent libpoly tessellator entry points used by PanVK's
+ * tessellation-as-compute path.
+ */
+KERNEL(64)
+panlib_tess_isoline(constant struct poly_tess_params *p,
+                    enum poly_tess_mode mode__2)
+{
+   if (cl_global_id.x >= p->nr_patches)
+      return;
+   poly_tess_isoline_process(p, cl_global_id.x, mode__2);
+}
+
+KERNEL(64)
+panlib_tess_tri(constant struct poly_tess_params *p,
+                enum poly_tess_mode mode__2)
+{
+   if (cl_global_id.x >= p->nr_patches)
+      return;
+   poly_tess_tri_process(p, cl_global_id.x, mode__2);
+}
+
+KERNEL(64)
+panlib_tess_quad(constant struct poly_tess_params *p,
+                 enum poly_tess_mode mode__2)
+{
+   if (cl_global_id.x >= p->nr_patches)
+      return;
+   poly_tess_quad_process(p, cl_global_id.x, mode__2);
+}
+
+KERNEL(1024)
+panlib_prefix_sum_tess(global struct poly_tess_params *p)
+{
+   local uint scratch[32];
+   poly_prefix_sum(scratch, p->counts, p->nr_patches, 1, 0, 1024);
+
+   barrier(CLK_LOCAL_MEM_FENCE);
+   if (cl_local_id.x != 0)
+      return;
+
+   const uint total = p->nr_patches ? p->counts[p->nr_patches - 1] : 0;
+   const uint32_t elsize_B = sizeof(uint32_t);
+   const uint alloc_B = poly_heap_alloc_offs(p->heap, total * elsize_B);
+
+   p->index_buffer =
+      (global uint32_t *)(((uintptr_t)p->heap->base) + alloc_B);
+
+   global uint32_t *draw = p->out_draws;
+   draw[0] = total;
+   draw[1] = 1;
+   draw[2] = alloc_B / elsize_B;
+   draw[3] = 0;
+   draw[4] = 0;
+}
+
+#endif
+
+#if PAN_ARCH == 9
+/* Mali-G57 (v9) can't run the 1024-wide prefix-sum workgroup (its barrier
+ * never completes).  Single-thread serial version with identical results:
+ * inclusive scan of counts, index allocation and the indexed indirect draw. */
+KERNEL(1)
+panlib_prefix_sum_tess_serial(global struct poly_tess_params *p)
+{
+   uint32_t sum = 0;
+   for (uint32_t i = 0; i < p->nr_patches; i++) {
+      sum += p->counts[i];
+      p->counts[i] = sum;
+   }
+
+   const uint total = sum;
+   const uint32_t elsize_B = sizeof(uint32_t);
+   const uint alloc_B = poly_heap_alloc_offs(p->heap, total * elsize_B);
+
+   p->index_buffer =
+      (global uint32_t *)(((uintptr_t)p->heap->base) + alloc_B);
+
+   global uint32_t *draw = p->out_draws;
+   draw[0] = total;
+   draw[1] = 1;
+   draw[2] = alloc_B / elsize_B;
+   draw[3] = 0;
+   draw[4] = 0;
+}
+#endif
diff --git a/src/panfrost/libpan/tests/vp_runs.c b/src/panfrost/libpan/tests/vp_runs.c
new file mode 100644
index 00000000000..99cb5d0da4f
--- /dev/null
+++ b/src/panfrost/libpan/tests/vp_runs.c
@@ -0,0 +1,402 @@
+/*
+ * Host emulation of panlib_vp_runs. Same .cl body.
+ * Topology and the packed-slot rank are the production helpers.
+ * libcl headers shadow libc, so they are not on the include path.
+ * OpenCL address-space words are empty here.
+ *
+ *   gcc -std=c11 -Wall -Werror -o /tmp/vp-runs \
+ *     src/panfrost/libpan/tests/vp_runs.c \
+ *     -Isrc/panfrost/libpan -Iinclude -Isrc -Isrc/panfrost \
+ *     && /tmp/vp-runs
+ */
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define global
+#define constant
+#define kernel
+#define __global
+#define __constant
+#define __kernel
+#define __attribute__(x)
+typedef unsigned int uint;
+
+#define UTIL_ARCH_LITTLE_ENDIAN 1
+#define UTIL_ARCH_BIG_ENDIAN 0
+#include "util/bitscan.h"
+#include "compiler/shader_enums.h"
+#include "poly/prim.h"
+
+#define PANLIB_VP_HOST 1
+#include "draw_helper_vp.h"
+#include "vp_runs.cl"
+
+#undef kernel
+#undef global
+
+#define CHECK(c)                                                               \
+   do {                                                                        \
+      if (!(c)) {                                                              \
+         fprintf(stderr, "vp_runs: %s\n", #c);                                 \
+         return 1;                                                             \
+      }                                                                        \
+   } while (0)
+
+#define STRIDE 512u
+
+static uint64_t
+outputs_with_viewport(void)
+{
+   return ((1ull << VARYING_SLOT_VIEWPORT) - 1) | VARYING_BIT_VIEWPORT;
+}
+
+static uint32_t
+vp_slot(void)
+{
+   return util_bitcount64(outputs_with_viewport() &
+                          BITFIELD64_MASK(VARYING_SLOT_VIEWPORT));
+}
+
+static void
+put_vp(uint32_t *rec, uint32_t id, uint32_t vp)
+{
+   rec[id * (STRIDE / 4) + vp_slot() * 4] = vp;
+   rec[id * (STRIDE / 4)] = 7;
+}
+
+static void
+call(const uint32_t *idx, uint32_t nidx, const uint32_t *rec, uint64_t outputs,
+     uint32_t vp_count, uint32_t prim, uint32_t prov_last, uint32_t icap,
+     uint32_t rcap, uint32_t *out, struct panlib_vp_run_header *hdr)
+{
+   memset(hdr, 0xa5, sizeof(*hdr) + 8 * sizeof(struct panlib_vp_run));
+   memset(out, 0xa5, 64 * sizeof(uint32_t));
+   panlib_vp_runs(idx, nidx, rec, STRIDE, outputs, vp_count, prim, prov_last,
+                  icap, rcap, out, hdr);
+}
+
+static int
+one_mode(uint32_t *rec, uint32_t prim, uint32_t prov_last, uint32_t nprim,
+         const uint32_t *expect_idx, const uint32_t *expect_vp)
+{
+   uint32_t idx[16];
+   uint32_t out[64];
+   struct {
+      struct panlib_vp_run_header h;
+      struct panlib_vp_run r[8];
+   } buf;
+   uint32_t nidx = prim == MESA_PRIM_POINTS ? nprim :
+                   prim == MESA_PRIM_LINES  ? nprim * 2 :
+                                              2 + nprim;
+
+   for (uint32_t i = 0; i < nidx; i++)
+      idx[i] = 10 + i;
+
+   call(idx, nidx, rec, outputs_with_viewport(), 4, prim, prov_last, 64, 8,
+        out, &buf.h);
+   CHECK(!buf.h.overflow);
+   CHECK(buf.h.index_count == nidx);
+   CHECK(buf.h.run_count >= 1);
+   for (uint32_t i = 0; i < nidx; i++)
+      CHECK(out[i] == expect_idx[i]);
+
+   uint32_t covered = 0;
+   for (uint32_t r = 0; r < buf.h.run_count; r++) {
+      CHECK(buf.r[r].first_index == covered);
+      CHECK(buf.r[r].viewport == expect_vp[r]);
+      covered += buf.r[r].index_count;
+   }
+   CHECK(covered == nidx);
+   return 0;
+}
+
+int
+main(void)
+{
+   CHECK(sizeof(struct panlib_vp_run_header) == PANLIB_VP_RUN_HEADER_BYTES);
+   CHECK(sizeof(struct panlib_vp_run) == PANLIB_VP_RUN_BYTES);
+   CHECK(util_bitcount64(outputs_with_viewport() &
+                         BITFIELD64_MASK(VARYING_SLOT_VIEWPORT)) ==
+         VARYING_SLOT_VIEWPORT);
+
+   uint64_t bytes = 0;
+   CHECK(panlib_vp_run_bytes(0, &bytes) && bytes == PANLIB_VP_RUN_HEADER_BYTES);
+   CHECK(panlib_vp_run_bytes(PANLIB_VP_MAX_RUNS, &bytes));
+   CHECK(!panlib_vp_run_bytes(PANLIB_VP_MAX_RUNS + 1, &bytes));
+   CHECK(bytes == PANLIB_VP_RUN_HEADER_BYTES + (uint64_t)PANLIB_VP_MAX_RUNS * 12);
+
+   uint32_t *rec = calloc(40, STRIDE);
+   CHECK(rec);
+   memset(rec, 0, 32 * STRIDE);
+   /* records 10..: viewports 0,0,1,1,1 then 2,9 */
+   put_vp(rec, 10, 0);
+   put_vp(rec, 11, 0);
+   put_vp(rec, 12, 1);
+   put_vp(rec, 13, 1);
+   put_vp(rec, 14, 1);
+   put_vp(rec, 15, 2);
+   put_vp(rec, 16, 9);
+
+   uint32_t out[64];
+   struct {
+      struct panlib_vp_run_header h;
+      struct panlib_vp_run r[8];
+   } buf;
+   uint64_t outs = outputs_with_viewport();
+
+   /* points: each point is its own run, 9 clamps to last viewport */
+   {
+      uint32_t idx[] = {10, 12, 16};
+      call(idx, 3, rec, outs, 4, MESA_PRIM_POINTS, 0, 64, 8, out, &buf.h);
+      CHECK(!buf.h.overflow && buf.h.run_count == 3 && buf.h.index_count == 3);
+      CHECK(buf.r[0].viewport == 0 && buf.r[1].viewport == 1 &&
+            buf.r[2].viewport == 3);
+      CHECK(out[0] == 10 && out[1] == 12 && out[2] == 16);
+   }
+
+   /* lines, list: (10,11) vp0, (12,13) vp1. Provoking last. */
+   {
+      uint32_t ei[] = {10, 11, 12, 13};
+      uint32_t ev[] = {0, 1};
+      CHECK(one_mode(rec, MESA_PRIM_LINES, 1, 2, ei, ev) == 0);
+   }
+
+   /* line strip, provoking last: (10,11) vp0, (11,12) vp1 */
+   {
+      uint32_t idx[] = {10, 11, 12};
+      call(idx, 3, rec, outs, 4, MESA_PRIM_LINE_STRIP, 1, 64, 8, out, &buf.h);
+      CHECK(!buf.h.overflow && buf.h.run_count == 2);
+      CHECK(buf.r[0].viewport == 0 && buf.r[0].index_count == 2);
+      CHECK(buf.r[1].viewport == 1 && buf.r[1].first_index == 2);
+      CHECK(out[2] == 11 && out[3] == 12);
+   }
+
+   /* triangles, list, one prim, provoking last is record 12 */
+   {
+      uint32_t ei[] = {10, 11, 12};
+      uint32_t ev[] = {1};
+      CHECK(one_mode(rec, MESA_PRIM_TRIANGLES, 1, 1, ei, ev) == 0);
+   }
+
+   /* triangle strip, provoking last, odd primitive swaps */
+   {
+      uint32_t idx[] = {10, 11, 12, 13, 14};
+      call(idx, 5, rec, outs, 4, MESA_PRIM_TRIANGLE_STRIP, 1, 64, 8, out,
+           &buf.h);
+      CHECK(!buf.h.overflow && buf.h.index_count == 9 && buf.h.run_count == 1);
+      CHECK(buf.r[0].viewport == 1 && buf.r[0].index_count == 9);
+      CHECK(out[0] == 10 && out[1] == 11 && out[2] == 12);
+      CHECK(out[3] == 12 && out[4] == 11 && out[5] == 13);
+      CHECK(out[6] == 12 && out[7] == 13 && out[8] == 14);
+   }
+
+   /* provoking first splits the strip: vp0 then vp1 */
+   {
+      uint32_t idx[] = {10, 11, 12, 13, 14};
+      call(idx, 5, rec, outs, 4, MESA_PRIM_TRIANGLE_STRIP, 0, 64, 8, out,
+           &buf.h);
+      CHECK(buf.h.run_count == 2);
+      CHECK(buf.r[0].viewport == 0 && buf.r[0].index_count == 6);
+      CHECK(buf.r[1].viewport == 1 && buf.r[1].first_index == 6 &&
+            buf.r[1].index_count == 3);
+      CHECK(out[3] == 11 && out[4] == 13 && out[5] == 12);
+   }
+
+   /* restart drops the tail of a strip and starts another */
+   {
+      uint32_t idx[] = {10, 11, 12, PANLIB_VP_RESTART, 15, 16};
+      call(idx, 6, rec, outs, 4, MESA_PRIM_LINE_STRIP, 1, 64, 8, out, &buf.h);
+      CHECK(!buf.h.overflow && buf.h.index_count == 6 && buf.h.run_count == 3);
+      CHECK(buf.r[0].viewport == 0 && out[0] == 10 && out[1] == 11);
+      CHECK(buf.r[1].viewport == 1 && out[2] == 11 && out[3] == 12);
+      CHECK(buf.r[2].viewport == 3 && out[4] == 15 && out[5] == 16);
+   }
+
+   /* no viewport output: every provoking vertex is viewport 0, one run */
+   {
+      uint32_t idx[] = {10, 12, 16};
+      call(idx, 3, rec, 0, 4, MESA_PRIM_POINTS, 0, 64, 8, out, &buf.h);
+      CHECK(buf.h.run_count == 1 && buf.r[0].viewport == 0 &&
+            buf.r[0].index_count == 3);
+   }
+
+   /* exact index cap merges into the open run; one past fails closed */
+   {
+      uint32_t idx[] = {10, 11, 12, 13};
+      call(idx, 4, rec, outs, 4, MESA_PRIM_TRIANGLE_STRIP, 1, 6, 1, out,
+           &buf.h);
+      CHECK(!buf.h.overflow && buf.h.index_count == 6 && buf.h.run_count == 1);
+      call(idx, 4, rec, outs, 4, MESA_PRIM_TRIANGLE_STRIP, 1, 5, 8, out,
+           &buf.h);
+      CHECK(buf.h.overflow == 1 && buf.h.index_count == 0 &&
+            buf.h.run_count == 0);
+   }
+
+   /* exact run cap, then one past: different viewports cannot merge */
+   {
+      uint32_t idx[] = {10, 12};
+      call(idx, 2, rec, outs, 4, MESA_PRIM_POINTS, 0, 64, 2, out, &buf.h);
+      CHECK(!buf.h.overflow && buf.h.run_count == 2);
+      call(idx, 2, rec, outs, 4, MESA_PRIM_POINTS, 0, 64, 1, out, &buf.h);
+      CHECK(buf.h.overflow == 1 && buf.h.index_count == 0 &&
+            buf.h.run_count == 0);
+   }
+
+   /* empty input and a restart-only buffer are valid empty draws */
+   {
+      call(NULL, 0, rec, outs, 4, MESA_PRIM_POINTS, 0, 64, 8, out, &buf.h);
+      CHECK(!buf.h.overflow && buf.h.index_count == 0 && buf.h.run_count == 0);
+      uint32_t holes[] = {PANLIB_VP_RESTART, PANLIB_VP_RESTART};
+      call(holes, 2, rec, outs, 4, MESA_PRIM_TRIANGLE_STRIP, 1, 64, 8, out,
+           &buf.h);
+      CHECK(!buf.h.overflow && buf.h.index_count == 0 && buf.h.run_count == 0);
+   }
+
+   /* zero capacities: nothing emitted is fine, one primitive is overflow */
+   {
+      uint32_t idx[] = {10};
+      call(idx, 0, rec, outs, 4, MESA_PRIM_POINTS, 0, 0, 0, out, &buf.h);
+      CHECK(!buf.h.overflow && buf.h.index_count == 0);
+      call(idx, 1, rec, outs, 4, MESA_PRIM_POINTS, 0, 0, 0, out, &buf.h);
+      CHECK(buf.h.overflow == 1 && buf.h.index_count == 0 &&
+            buf.h.run_count == 0);
+   }
+
+   /* absent viewport, record_stride 0: one run, viewport 0, no record read */
+   {
+      uint32_t idx[] = {10, 11, 12};
+      memset(&buf, 0, sizeof(buf));
+      panlib_vp_runs(idx, 3, NULL, 0, 0, 4, MESA_PRIM_POINTS, 0, 64, 8, out,
+                     &buf.h);
+      CHECK(!buf.h.overflow && buf.h.run_count == 1 && buf.r[0].viewport == 0 &&
+            buf.r[0].index_count == 3);
+   }
+
+   /* sparse mask: only viewport bit set, so the slot rank is 0 */
+   {
+      uint32_t idx[] = {0};
+      rec[0] = 2;
+      call(idx, 1, rec, VARYING_BIT_VIEWPORT, 4, MESA_PRIM_POINTS, 0, 64, 8,
+           out, &buf.h);
+      CHECK(!buf.h.overflow && buf.h.run_count == 1 && buf.r[0].viewport == 2);
+      rec[0] = 7;
+   }
+
+   /* quads are not a GS output mode */
+   {
+      uint32_t idx[] = {10, 11, 12, 13};
+      call(idx, 4, rec, outs, 4, MESA_PRIM_QUADS, 1, 64, 8, out, &buf.h);
+      CHECK(buf.h.overflow == 1 && buf.h.index_count == 0 &&
+            buf.h.run_count == 0);
+   }
+
+   /* restart inside a triangle strip: odd primitive after the cut */
+   {
+      uint32_t idx[] = {10, 11, 12, 13, PANLIB_VP_RESTART, 12, 13, 14};
+      call(idx, 8, rec, outs, 4, MESA_PRIM_TRIANGLE_STRIP, 1, 64, 8, out,
+           &buf.h);
+      /* First segment: even (10,11,12), odd swapped (12,11,13).
+       * Restart resets parity, so the next segment starts even again.
+       */
+      CHECK(!buf.h.overflow && buf.h.index_count == 9 && buf.h.run_count == 1);
+      CHECK(out[0] == 10 && out[1] == 11 && out[2] == 12);
+      CHECK(out[3] == 12 && out[4] == 11 && out[5] == 13);
+      CHECK(out[6] == 12 && out[7] == 13 && out[8] == 14);
+      CHECK(buf.r[0].viewport == 1);
+   }
+
+   /* canaries past the written indices and past the one run stay put */
+   {
+      uint32_t idx[] = {10};
+      memset(out, 0xa5, 64 * sizeof(uint32_t));
+      memset(&buf, 0xa5, sizeof(buf));
+      panlib_vp_runs(idx, 1, rec, STRIDE, outs, 4, MESA_PRIM_POINTS, 0, 64, 8,
+                     out, &buf.h);
+      CHECK(!buf.h.overflow && buf.h.index_count == 1 && buf.h.run_count == 1);
+      CHECK(out[0] == 10 && out[1] == 0xa5a5a5a5u);
+      CHECK(buf.r[1].viewport == 0xa5a5a5a5u);
+   }
+
+   /* limits: an output capacity past the documented bound discards the draw */
+   {
+      uint32_t idx[] = {10};
+      call(idx, 1, rec, outs, 4, MESA_PRIM_POINTS, 0,
+           PANLIB_VP_MAX_OUT_INDICES + 1, 1, out, &buf.h);
+      CHECK(buf.h.overflow == 1 && buf.h.index_count == 0 &&
+            buf.h.run_count == 0);
+      call(idx, PANLIB_VP_MAX_INPUT_INDICES + 1, rec, outs, 4, MESA_PRIM_POINTS,
+           0, 64, 1, out, &buf.h);
+      CHECK(buf.h.overflow == 1 && buf.h.run_count == 0);
+   }
+
+   /* A count past the output capacity discards the draw. */
+   {
+      uint32_t idx[] = {10, 11, 12};
+      call(idx, 3, rec, outs, 4, MESA_PRIM_POINTS, 0, 2, 8, out, &buf.h);
+      CHECK(buf.h.overflow == 1 && buf.h.index_count == 0 &&
+            buf.h.run_count == 0);
+   }
+
+   /* VS draw: two instances of two points, instance k reads records at
+    * 2 * k. Ids 0..3 pick viewports 0, 1, 1, 0.
+    */
+   {
+      uint32_t idx[] = {0, 1};
+      const uint32_t vps[] = {0, 1, 1, 0};
+
+      for (uint32_t i = 0; i < 4; i++)
+         put_vp(rec, 20 + i, vps[i]);
+      memset(out, 0xa5, 64 * sizeof(uint32_t));
+      memset(&buf, 0xa5, sizeof(buf));
+      for (uint32_t i = 0; i < 2; i++)
+         idx[i] += 20;
+      panlib_vp_runs_n(idx, 2, rec, STRIDE, outs, 4, MESA_PRIM_POINTS, 0, 64,
+                       8, out, &buf.h, 2, 2, 0, 0);
+      CHECK(!buf.h.overflow && buf.h.index_count == 4 && buf.h.run_count == 3);
+      CHECK(out[0] == 20 && out[1] == 21 && out[2] == 22 && out[3] == 23);
+      CHECK(buf.r[0].viewport == 0 && buf.r[0].index_count == 1);
+      CHECK(buf.r[1].viewport == 1 && buf.r[1].first_index == 1 &&
+            buf.r[1].index_count == 2);
+      CHECK(buf.r[2].viewport == 0 && buf.r[2].first_index == 3);
+      /* the instance offset must not wrap */
+      panlib_vp_runs_n(idx, 2, rec, STRIDE, outs, 4, MESA_PRIM_POINTS, 0, 64,
+                       8, out, &buf.h, 2, 0xffffffffu, 0, 0);
+      CHECK(buf.h.overflow == 1 && buf.h.run_count == 0);
+
+      /* pack_prim_id: the primitive ID rides in bits 16+, per instance. */
+      panlib_vp_runs_n(idx, 2, rec, STRIDE, outs, 4, MESA_PRIM_POINTS, 0, 64,
+                       8, out, &buf.h, 2, 2, 1, 0);
+      CHECK(!buf.h.overflow && buf.h.index_count == 4 && buf.h.run_count == 3);
+      CHECK(out[0] == 20 && out[1] == (21 | 1u << 16) && out[2] == 22 &&
+            out[3] == (23 | 1u << 16));
+   }
+
+   /* pack_prim_id counts across a restart, and a record past 16 bits
+    * discards the draw.
+    */
+   {
+      uint32_t idx[] = {20, PANLIB_VP_RESTART, 21};
+      panlib_vp_runs_n(idx, 3, rec, STRIDE, outs, 4, MESA_PRIM_POINTS, 0, 64,
+                       8, out, &buf.h, 1, 0, 1, 0);
+      CHECK(!buf.h.overflow && buf.h.index_count == 2);
+      CHECK(out[0] == 20 && out[1] == (21 | 1u << 16));
+
+      uint32_t big[] = {0x10000};
+      panlib_vp_runs_n(big, 1, NULL, 0, 0, 4, MESA_PRIM_POINTS, 0, 64, 8, out,
+                       &buf.h, 1, 0, 1, 0);
+      CHECK(buf.h.overflow == 1);
+
+      /* A CPU-split chunk starts at its primitive base, IDs wrap at 16 bits. */
+      uint32_t two[] = {20, 21};
+      panlib_vp_runs_n(two, 2, rec, STRIDE, outs, 4, MESA_PRIM_POINTS, 0, 64,
+                       8, out, &buf.h, 1, 0, 1, 0xffff);
+      CHECK(!buf.h.overflow && out[0] == (20 | 0xffffu << 16) && out[1] == 21);
+   }
+
+   free(rec);
+   printf("vp_runs ok\n");
+   return 0;
+}
diff --git a/src/panfrost/libpan/vp_runs.cl b/src/panfrost/libpan/vp_runs.cl
new file mode 100644
index 00000000000..001eb37e207
--- /dev/null
+++ b/src/panfrost/libpan/vp_runs.cl
@@ -0,0 +1,250 @@
+#ifdef PANLIB_VP_HOST
+#define VP_GLOBAL
+#define VP_CONST const
+#else
+#define VP_GLOBAL global
+#define VP_CONST global const
+#endif
+
+static bool
+vp_add_u32(uint32_t a, uint32_t b, uint32_t *out)
+{
+   if (a > UINT32_MAX - b)
+      return false;
+   *out = a + b;
+   return true;
+}
+
+/* Provoking vertex's packed slot, clamped into the active table.
+ * Missing slot is viewport 0. count is at least 1.
+ */
+static uint32_t
+vp_prim_viewport(VP_CONST uint32_t *records, uint32_t record_stride,
+                 uint32_t vp_slot, bool has_vp, uint32_t provoking,
+                 uint32_t count)
+{
+   uint32_t vp = 0;
+
+   if (has_vp) {
+      VP_CONST uint32_t *rec =
+         (VP_CONST uint32_t *)((VP_CONST char *)records +
+                               (uint64_t)provoking * record_stride);
+      vp = rec[vp_slot * 4];
+   }
+   return vp < count ? vp : count - 1;
+}
+
+/* A new run needs a free slot. A merge into the open run does not.
+ * Either way the primitive's vertices must fit. Failure discards later.
+ */
+static bool
+vp_emit(VP_GLOBAL uint32_t *out_indices, VP_GLOBAL struct panlib_vp_run *runs,
+        uint32_t *nidx, uint32_t *nrun, uint32_t index_cap, uint32_t run_cap,
+        uint32_t vp, uint32_t k, const uint32_t *vtx)
+{
+   uint32_t next;
+   bool merge = *nrun && runs[*nrun - 1].viewport == vp &&
+                runs[*nrun - 1].first_index + runs[*nrun - 1].index_count == *nidx;
+
+   if (!vp_add_u32(*nidx, k, &next) || next > index_cap)
+      return false;
+   if (!merge && (*nrun >= run_cap || !vp_add_u32(*nrun, 1, &next)))
+      return false;
+
+   if (merge)
+      runs[*nrun - 1].index_count += k;
+   else {
+      runs[*nrun].viewport = vp;
+      runs[*nrun].first_index = *nidx;
+      runs[*nrun].index_count = k;
+      (*nrun)++;
+   }
+   for (uint32_t v = 0; v < k; v++)
+      out_indices[(*nidx)++] = vtx[v];
+   return true;
+}
+
+static bool
+vp_prim(VP_CONST uint32_t *in_indices, VP_CONST uint32_t *records,
+        uint32_t record_stride, uint32_t vp_slot, bool has_vp, uint32_t count,
+        uint32_t prim, bool provoking_last, uint32_t p, uint32_t num_prims,
+        uint32_t base, uint32_t rec_base, VP_GLOBAL uint32_t *out_indices,
+        VP_GLOBAL struct panlib_vp_run *runs, uint32_t *nidx, uint32_t *nrun,
+        uint32_t index_cap, uint32_t run_cap, bool pack_prim_id, uint32_t pid)
+{
+   uint32_t k = mesa_vertices_per_prim((enum mesa_prim)prim);
+   uint32_t vtx[3];
+   uint32_t prov = provoking_last ? k - 1 : 0;
+
+   if (k == 0 || k > 3)
+      return false;
+
+   for (uint32_t v = 0; v < k; v++) {
+      uint32_t at;
+      if (!vp_add_u32(base, poly_vertex_id_for_topology((enum mesa_prim)prim,
+                                                     !provoking_last, p, v,
+                                                     num_prims),
+                      &at))
+         return false;
+      /* rec_base is the record index of instance k's vertex 0 for a VS draw
+       * where every instance has its own records. 0 otherwise.
+       */
+      if (!vp_add_u32(in_indices[at], rec_base, &vtx[v]))
+         return false;
+   }
+   uint32_t vp = vp_prim_viewport(records, record_stride, vp_slot, has_vp,
+                                  vtx[prov], count);
+
+   /* The FS primitive ID restarts with each run draw: carry it in the index
+    * bits 16+ instead (PANLIB_VP_PRIM_ID_SHIFT), the passthrough VS outputs
+    * it. ponytail: 16 bits, IDs wrap past 65535; widen with a side buffer
+    * indexed by the record if an app cares.
+    */
+   if (pack_prim_id) {
+      for (uint32_t v = 0; v < k; v++) {
+         if (vtx[v] > PANLIB_VP_PACKED_RECORD_MASK)
+            return false;
+         vtx[v] |= pid << PANLIB_VP_PRIM_ID_SHIFT;
+      }
+   }
+   return vp_emit(out_indices, runs, nidx, nrun, index_cap, run_cap, vp, k,
+                  vtx);
+}
+
+/* instances > 1 repeats the index list once per instance, instance k reading
+ * records at k * instance_stride. Only a VS draw has per-instance records, a
+ * GS draw passes instances = 1.
+ */
+static void
+panlib_vp_runs_n(VP_CONST uint32_t *in_indices, uint32_t index_count,
+                 VP_CONST uint32_t *records, uint32_t record_stride,
+                 uint64_t outputs_written, uint32_t viewport_count,
+                 uint32_t prim, uint32_t provoking_last,
+                 uint32_t index_capacity, uint32_t run_capacity,
+                 VP_GLOBAL uint32_t *out_indices,
+                 VP_GLOBAL struct panlib_vp_run_header *header,
+                 uint32_t instances, uint32_t instance_stride,
+                 uint32_t pack_prim_id, uint32_t prim_base)
+{
+   bool has_vp = (outputs_written & VARYING_BIT_VIEWPORT) != 0;
+   uint32_t vp_slot = util_bitcount64(outputs_written &
+                                      BITFIELD64_MASK(VARYING_SLOT_VIEWPORT));
+   uint32_t count = viewport_count ? viewport_count : 1;
+   uint32_t slot_bytes;
+   bool overflow = false;
+   bool accepted = prim == MESA_PRIM_POINTS || prim == MESA_PRIM_LINES ||
+                   prim == MESA_PRIM_LINE_STRIP || prim == MESA_PRIM_TRIANGLES ||
+                   prim == MESA_PRIM_TRIANGLE_STRIP ||
+                   prim == MESA_PRIM_TRIANGLE_FAN;
+
+   if (count > PANLIB_VP_MAX_VIEWPORTS)
+      count = PANLIB_VP_MAX_VIEWPORTS;
+   /* Empty input is a valid empty draw. Stride is checked only when a
+    * viewport slot is actually read. record_stride 0 is fine if aligned
+    * and the slot is absent.
+    */
+   if (!accepted || index_count > PANLIB_VP_MAX_INPUT_INDICES ||
+       index_count > index_capacity ||
+       index_capacity > PANLIB_VP_MAX_OUT_INDICES ||
+       run_capacity > PANLIB_VP_MAX_RUNS || (record_stride & 3) ||
+       (has_vp && (!vp_add_u32(vp_slot * 16, 4, &slot_bytes) ||
+                   slot_bytes > record_stride)))
+      overflow = true;
+
+   VP_GLOBAL struct panlib_vp_run *runs =
+      (VP_GLOBAL struct panlib_vp_run *)(header + 1);
+   uint32_t nidx = 0, nrun = 0;
+   bool prov_last = provoking_last != 0;
+
+   for (uint32_t inst = 0; inst < instances && !overflow; inst++) {
+   uint64_t rec64 = (uint64_t)inst * instance_stride;
+   uint32_t rec_base = (uint32_t)rec64;
+   uint32_t needle = 0;
+   /* Primitive ID: counts across restarts, restarts with each instance.
+    * prim_base is the first primitive of a CPU-split chunk (one instance).
+    */
+   uint32_t pid = prim_base;
+
+   if (rec64 > UINT32_MAX - 1)
+      overflow = true;
+   while (needle < index_count && !overflow) {
+      uint32_t next = index_count;
+
+      for (uint32_t i = needle; i < index_count; i++) {
+         if (in_indices[i] == PANLIB_VP_RESTART) {
+            next = i;
+            break;
+         }
+      }
+
+      uint32_t len = next - needle;
+      uint32_t prims =
+         u_decomposed_prims_for_vertices((enum mesa_prim)prim, (int)len);
+
+      for (uint32_t p = 0; p < prims && !overflow; p++, pid++) {
+         overflow = !vp_prim(in_indices, records, record_stride, vp_slot,
+                             has_vp, count, prim, prov_last, p, prims,
+                             needle, rec_base, out_indices, runs, &nidx,
+                             &nrun, index_capacity, run_capacity,
+                             pack_prim_id != 0, pid & 0xffffu);
+      }
+      if (!vp_add_u32(next, 1, &needle))
+         overflow = true;
+   }
+   }
+
+   /* Fail closed: a partial draw is not a draw. */
+   header->index_count = overflow ? 0 : nidx;
+   header->run_count = overflow ? 0 : nrun;
+   header->overflow = overflow ? 1 : 0;
+}
+
+__attribute__((unused)) static void
+panlib_vp_runs(VP_CONST uint32_t *in_indices, uint32_t index_count,
+               VP_CONST uint32_t *records, uint32_t record_stride,
+               uint64_t outputs_written, uint32_t viewport_count,
+               uint32_t prim, uint32_t provoking_last, uint32_t index_capacity,
+               uint32_t run_capacity, VP_GLOBAL uint32_t *out_indices,
+               VP_GLOBAL struct panlib_vp_run_header *header)
+{
+   panlib_vp_runs_n(in_indices, index_count, records, record_stride,
+                    outputs_written, viewport_count, prim, provoking_last,
+                    index_capacity, run_capacity, out_indices, header, 1, 0,
+                    0, 0);
+}
+
+#ifndef PANLIB_VP_HOST
+/* counts points at the GS draw word: the number of indices the GS kernel
+ * restart-filled. Slots past it are untouched and must not be read.
+ */
+KERNEL(1)
+panlib_vp_runs_launch(uint64_t in_indices, uint64_t records,
+                     uint64_t out_indices, uint64_t header,
+                     uint64_t outputs_written, uint64_t counts,
+                     uint32_t record_stride, uint32_t viewport_count,
+                     uint32_t prim, uint32_t provoking_last,
+                     uint32_t index_bound, uint32_t index_capacity,
+                     uint32_t run_capacity, uint32_t per_instance,
+                     uint32_t pack_prim_id, uint32_t prim_base)
+{
+   uint32_t n = *((global const uint32_t *)counts);
+   /* A VS draw: counts is {vertex count, instance count}, and instance k
+    * owns the n records after instance k - 1.
+    */
+   uint32_t instances = per_instance ? ((global const uint32_t *)counts)[1] : 1;
+
+   /* A count past the filled region means the draw word is not the one
+    * this allocation was sized for. Force the walker's overflow path.
+    */
+   if (n > index_bound ||
+       (per_instance && (uint64_t)n * instances > index_bound))
+      n = PANLIB_VP_MAX_INPUT_INDICES + 1;
+   panlib_vp_runs_n((global const uint32_t *)in_indices, n,
+                    (global const uint32_t *)records, record_stride,
+                    outputs_written, viewport_count, prim, provoking_last,
+                    index_capacity, run_capacity,
+                    (global uint32_t *)out_indices,
+                    (global struct panlib_vp_run_header *)header, instances,
+                    per_instance ? n : 0, pack_prim_id, prim_base);
+}
+#endif
diff --git a/src/panfrost/model/pan_model.c b/src/panfrost/model/pan_model.c
index d9bdd285989..190dcaef1e9 100644
--- a/src/panfrost/model/pan_model.c
+++ b/src/panfrost/model/pan_model.c
@@ -86,12 +86,26 @@ const struct pan_model pan_model_list[] = {
    BIFROST_MODEL(PAN_PROD_ID(7, 2, 2),    "G52",    "G52", MODEL_ANISO(ALL),  MODEL_TB_SIZES(16384,  8192), MODEL_RATES(2, 2, 24)),
    BIFROST_MODEL(PAN_PROD_ID(7, 4, 2),    "G52 r1", "G52", MODEL_ANISO(ALL),  MODEL_TB_SIZES( 8192,  8192), MODEL_RATES(2, 2, 24)),
 
+   /* G77 (kbase TTRX, 0x9080): same Valhall v9 core as G57, 7-16 cores. */
+   VALHALL_MODEL(PAN_PROD_ID(9, 0, 0), 0, "G77",    "G77", MODEL_ANISO(ALL),  MODEL_TB_SIZES(16384,  8192),
+                                              MODEL_RATES_X(2, 4, 8,  32,  32, 8)),
    VALHALL_MODEL(PAN_PROD_ID(9, 0, 1), 0, "G57",    "G77", MODEL_ANISO(ALL),  MODEL_TB_SIZES(16384,  8192),
                                               MODEL_RATES_X(2, 4, 8,  32,  32, 8)),
    VALHALL_MODEL(PAN_PROD_ID(9, 0, 3), 0, "G57",    "G77", MODEL_ANISO(ALL),  MODEL_TB_SIZES(16384,  8192),
                                               MODEL_RATES_X(2, 4, 8,  32,  32, 8)),
    VALHALL_MODEL(PAN_PROD_ID(9, 2, 4), 0, "G68",    "G78", MODEL_ANISO(ALL),  MODEL_TB_SIZES(16384,  8192),
                                               MODEL_RATES_X(2, 4, 8,  32,  32, 8)),
+   /* G78 (kbase TBEX, product major 2; Tensor gs101 reports 0x9202) and
+    * G78AE (product major 5): same v9 core and 16 KiB colour tile buffer as
+    * the G57/G68. Transaction elimination produces stale tiles on G78
+    * (gs101); panvk only enables CRC on v10+, so it stays off here. */
+   VALHALL_MODEL(PAN_PROD_ID(9, 2, 2), 0, "G78",    "G78", MODEL_ANISO(ALL),  MODEL_TB_SIZES(16384,  8192),
+                                              MODEL_RATES_X(2, 4, 8,  32,  32, 8)),
+   VALHALL_MODEL(PAN_PROD_ID(9, 0, 5), 0, "G78AE",  "G78", MODEL_ANISO(ALL),  MODEL_TB_SIZES(16384,  8192),
+                                              MODEL_RATES_X(2, 4, 8,  32,  32, 8)),
+   /* G710 (kbase TODX, 0xa862): same Valhall v10 core as G610, 7-16 cores. */
+   VALHALL_MODEL(PAN_PROD_ID(10, 8, 2), 0, "G710",   "G710", MODEL_ANISO(ALL),  MODEL_TB_SIZES(32768, 16384),
+                                              MODEL_RATES_X(4, 8, 16,  64,  64, 16)),
    VALHALL_MODEL(PAN_PROD_ID(10, 8, 7), 0, "G610",   "G710", MODEL_ANISO(ALL),  MODEL_TB_SIZES(32768, 16384),
                                               MODEL_RATES_X(4, 8, 16,  64,  64, 16)),
    /* var/cvt/sfu rates might not be correct (we haven't found any detailed documentation) */
@@ -177,5 +191,27 @@ pan_get_model(uint64_t gpu_id, uint32_t gpu_variant,
          return &pan_model_list[i];
    }
 
+   /* kbase names v9 products by arch major and product major only
+    * (GPU_ID2_PRODUCT_MODEL, mask 0xf00f): arch minor is not part of the
+    * product, and parts report different values (gs101's G78: 0x9202). */
+   if ((gpu_prod_id >> 16) == 9) {
+      for (unsigned i = 0; i < ARRAY_SIZE(pan_model_list); ++i) {
+         if ((pan_model_list[i].gpu_prod_id & ~0xff00) ==
+                (gpu_prod_id & ~0xff00) &&
+             pan_model_list[i].gpu_variant == gpu_variant)
+            return &pan_model_list[i];
+      }
+   }
+
+   /* Bifrost (v6/v7) rows carry no variant, but some kbase kernels report
+    * one anyway (G52 r1 0x74021000 says variant 0x2), so match on the
+    * product id alone there. */
+   if ((gpu_prod_id >> 16) >= 6 && (gpu_prod_id >> 16) < 9) {
+      for (unsigned i = 0; i < ARRAY_SIZE(pan_model_list); ++i) {
+         if (pan_model_list[i].gpu_prod_id == gpu_prod_id)
+            return &pan_model_list[i];
+      }
+   }
+
    return NULL;
 }
diff --git a/src/panfrost/vulkan/bc/gen_spv.sh b/src/panfrost/vulkan/bc/gen_spv.sh
new file mode 100644
index 00000000000..c19d58ffd3b
--- /dev/null
+++ b/src/panfrost/vulkan/bc/gen_spv.sh
@@ -0,0 +1,29 @@
+#!/bin/sh
+# Regenerate the BC decoder SPIR-V headers (compute + fragment variants).
+set -eu
+cd "$(dirname "$0")"
+for s in s3tc rgtc bc6 bc7; do
+   glslangValidator -V --target-env vulkan1.1 --vn panvk_bc_${s}_spv \
+      -o panvk_bc_${s}_spv.h panvk_bc_${s}.comp
+   glslangValidator -V --target-env vulkan1.1 -S frag -DPANVK_BC_FS \
+      --vn panvk_bc_${s}_fs_spv -o panvk_bc_${s}_fs_spv.h panvk_bc_${s}.comp
+done
+# BC1-BC5 -> ETC2/EAC transcoder of the lowmem path (compute only).
+glslangValidator -V --target-env vulkan1.1 --vn panvk_bc_etc2_spv \
+   -o panvk_bc_etc2_spv.h panvk_bc_etc2.comp
+# BC6H UF16 -> ASTC 4x4 HDR transcoder (csf-v11/202, compute only).
