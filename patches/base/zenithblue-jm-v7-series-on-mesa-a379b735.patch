+   struct panvk_prerast_viewport vp[16];
+};
+
+static_assert(offsetof(struct panvk_prerast_vp_table, vp) == 16,
+              "prerast viewport table header is 16 bytes");
+static_assert(sizeof(struct panvk_prerast_viewport) == 48,
+              "prerast viewport entry is 48 bytes");
+static_assert(offsetof(struct panvk_prerast_viewport, offset) == 16,
+              "prerast viewport offset");
+static_assert(offsetof(struct panvk_prerast_viewport, minx) == 32,
+              "prerast viewport box");
+
+struct panvk_gpu_prerast_io {
+   uint32_t abi_version;
+   uint32_t record_stride;
+   uint64_t outputs_written;
+   uint16_t varying_count;
+   uint8_t clip_distance_array_size;
+   uint8_t cull_distance_array_size;
+   struct pan_varying_layout varyings;
+};
+
+struct panvk_gpu_prerast_gs_info {
+   uint64_t outputs_written;
+   uint32_t record_stride;
+   uint32_t index_stride;
+   uint16_t max_vertices;
+   uint8_t invocations;
+   uint8_t input_prim;
+   uint8_t output_prim;
+   bool kernel_compiled;
+   bool passthrough_compiled;
+   bool xfb;
+   uint8_t scissor_clip_loc;
+};
+
+/* TCS/TES state the tessellation kernels need. The tessellation modes are
+ * recorded by both stages, the TES ones win when set. */
+struct panvk_gpu_prerast_tess_info {
+   uint64_t per_vertex_outputs;
+   uint32_t stride_el;
+   uint8_t patch_constants;
+   uint8_t out_patch_size;
+   uint8_t domain;
+   uint8_t spacing;
+   bool ccw;
+   bool point_mode;
+   bool compiled;
+   bool _pad;
+};
+
+struct panvk_gpu_prerast_xfb_info {
+   uint16_t stride[PANLIB_XFB_MAX_BUFFERS];
+   uint8_t buffer_to_stream[PANLIB_XFB_MAX_BUFFERS];
+   uint8_t output_count;
+   uint8_t _pad[3];
+   uint32_t outputs[PANLIB_XFB_MAX_OUTPUTS];
+};
+
+static inline bool
+panvk_gpu_prerast_has_xfb(const struct panvk_gpu_prerast_xfb_info *x)
+{
+   for (unsigned b = 0; b < PANLIB_XFB_MAX_BUFFERS; b++) {
+      if (x->stride[b])
+         return true;
+   }
+   return false;
+}
+
+struct panvk_gpu_prerast_shader {
+   struct panvk_gpu_prerast_io io;
+   struct panvk_gpu_prerast_gs_info gs;
+   struct panvk_gpu_prerast_tess_info tess;
+   struct panvk_gpu_prerast_xfb_info xfb;
+   uint32_t requirements;
+   bool lowered_vs_compiled;
+   bool passthrough_vs_compiled;
+   bool polygon_compiled;
+   bool has_side_effects;
+   /* Clip slot that carries the per-viewport scissor planes when this VS/TES
+    * is the last pre-raster stage and writes ViewportIndex. 0 if not.
+    */
+   uint8_t vp_scissor_loc;
+};
+
+struct panvk_gpu_prerast_gs_params {
+   uint64_t vs_records;
+   uint64_t vs_outputs;
+   uint64_t gen_indices;
+   uint64_t records;
+   uint64_t indices;
+   uint64_t draw;
+   uint32_t vertex_count;
+   uint32_t instance_count;
+   uint32_t primitive_restart;
+   uint32_t prim;
+   uint32_t cap_slots;
+   uint32_t vs_record_capacity;
+   uint32_t provoking_last;
+   uint32_t prim_id_base;
+   uint32_t raster_stream;
+   uint32_t _pad;
+   /* Pipeline statistics counters the GS kernel adds to, 0 when not
+    * counted: GS invocations, GS primitives, clipping invocations and
+    * clipping primitives. */
+   uint64_t stats[4];
+   /* 32-bit primitives generated query counter, 0 when no query is active. */
+   uint64_t prims_generated;
+   /* panlib_gs_strip_table() output when primitive restart is on. */
+   uint64_t strips;
+};
+
+/* The GS strip table lives in the polygon-mode index region: a GS draw has
+ * no polygon mode pass. Three words per generated index.
+ */
+#define PANVK_GPU_PRERAST_GS_STRIP_OFFSET PANVK_GPU_PRERAST_POLY_INDEX_OFFSET
+#define PANVK_GPU_PRERAST_GS_STRIP_CAP PANVK_GPU_PRERAST_MAX_INVOCATIONS
+static_assert(PANVK_GPU_PRERAST_GS_STRIP_OFFSET +
+                    3ull * PANVK_GPU_PRERAST_GS_STRIP_CAP * sizeof(uint32_t) <=
+                 PANVK_GPU_PRERAST_RECORD_OFFSET,
+              "gpu_prerast GS strip table overlaps the VS records");
+
+static_assert(PANVK_GPU_PRERAST_GS_PARAMS_OFFSET +
+                    sizeof(struct panvk_gpu_prerast_gs_params) <=
+                 PANVK_GPU_PRERAST_INDEX_OFFSET,
+              "gpu_prerast GS params overlap the index buffer");
+
+static inline uint32_t
+panvk_gpu_prerast_gs_cap_slots(const struct panvk_gpu_prerast_gs_info *gs)
+{
+   if (!gs->max_vertices || !gs->record_stride || !gs->index_stride)
+      return 0;
+
+   uint64_t rec = (PANVK_GPU_PRERAST_ARENA_SIZE -
+                   PANVK_GPU_PRERAST_GS_RECORD_OFFSET) /
+                  ((uint64_t)gs->record_stride * gs->max_vertices);
+   uint64_t idx = PANVK_GPU_PRERAST_GS_INDEX_CAPACITY / gs->index_stride;
+   return MIN2(rec, idx);
+}
+
+struct panvk_gpu_prerast_draw {
+   uint64_t index_buffer;
+   uint64_t indirect_buffer;
+   uint64_t indirect_count_buffer;
+   uint32_t index_buffer_size;
+   uint32_t index_offset;
+   uint32_t index_size;
+   int32_t vertex_offset;
+   uint32_t vertex_count;
+   uint32_t first_instance;
+   uint32_t instance_count;
+   uint32_t draw_count;
+   uint32_t indirect_stride;
+   enum mesa_prim prim;
+   bool primitive_restart;
+};
+
+struct panvk_gpu_prerast_execution {
+   uint32_t abi_version;
+   uint32_t record_stride;
+   uint64_t record_count;
+   uint64_t execution_id;
+};
+
+struct panvk_gpu_prerast_params {
+   struct poly_vertex_params vertex;
+   uint64_t generated_indices;
+   uint64_t generated_draw;
+   uint32_t vertex_count;
+   uint32_t instance_count;
+   uint32_t first_instance;
+   uint32_t restart_index;
+   uint32_t primitive_restart;
+   uint32_t index_offset;
+   uint32_t record_capacity;
+   uint32_t draw_id;
+   /* Tessellation chunk start, added to the invocation IDs. */
+   uint32_t chunk_vertex;
+   uint32_t chunk_instance;
+   struct {
+      uint64_t indices;
+      uint64_t draw;
+      uint32_t mode;
+      uint32_t prim;
+      uint32_t cull;
+      uint32_t front_ccw;
+      uint32_t flip_y;
+      uint32_t _pad;
+   } poly;
+};
+
+static_assert(PANVK_GPU_PRERAST_PARAMS_OFFSET +
+                    sizeof(struct panvk_gpu_prerast_params) <=
+                 PANVK_GPU_PRERAST_DISPATCH_OFFSET,
+              "gpu_prerast params overlap the dispatch words");
+
+static inline uint32_t
+panvk_gpu_prerast_record_capacity(uint32_t record_stride)
+{
+   uint64_t cap = record_stride
+      ? (PANVK_GPU_PRERAST_VS_REGION_END - PANVK_GPU_PRERAST_RECORD_OFFSET) /
+           record_stride
+      : 0;
+   return MIN2(cap, PANVK_GPU_PRERAST_MAX_INVOCATIONS);
+}
+
+/* The tessellation arena reuses the gpu_prerast header and VS region layout
+ * for the control points, the TCS outputs, domain points and indices live
+ * past it. Sized for patches tessellated at the maximum level.
+ */
+#define PANVK_GPU_PRERAST_TESS_ARENA_SIZE (96ull * 1024 * 1024)
+#define PANVK_GPU_PRERAST_TESS_DATA_OFFSET PANVK_GPU_PRERAST_VS_REGION_END
+#define PANVK_GPU_PRERAST_TESS_MAX_LEVEL 64
+#define PANVK_GPU_PRERAST_TESS_MAX_PATCH_SIZE 32
+#define PANVK_GPU_PRERAST_TESS_UNSET 0xff
+#define PANVK_GPU_PRERAST_TESS_MAX_POINTS                                      \
+   ((PANVK_GPU_PRERAST_TESS_MAX_LEVEL + 1) *                                   \
+    (PANVK_GPU_PRERAST_TESS_MAX_LEVEL + 1))
+#define PANVK_GPU_PRERAST_TESS_MAX_INDICES                                     \
+   (PANVK_GPU_PRERAST_TESS_MAX_LEVEL * PANVK_GPU_PRERAST_TESS_MAX_LEVEL * 6)
+
+static_assert(offsetof(struct panlib_tess_draw, total_patches) % 8 == 0,
+              "panlib_tess_draw 64-bit fields must be aligned");
+
+struct panvk_gpu_prerast_tess_layout {
+   uint64_t tcs, counts, coord_allocs, heap, index;
+   uint32_t heap_size, index_size;
+};
+
+static inline uint64_t
+panvk_gpu_prerast_tess_patch_bytes(uint32_t tcs_stride_B)
+{
+   return ALIGN_POT((uint64_t)tcs_stride_B, 16) + 2 * sizeof(uint32_t) +
+          PANVK_GPU_PRERAST_TESS_MAX_POINTS * sizeof(struct poly_tess_point) +
+          16 + PANVK_GPU_PRERAST_TESS_MAX_INDICES * sizeof(uint32_t);
+}
+
+static inline uint32_t
+panvk_gpu_prerast_tess_max_patches(uint32_t tcs_stride_B,
+                                   uint32_t vs_record_stride,
+                                   uint32_t patch_size)
+{
+   uint64_t tess = (PANVK_GPU_PRERAST_TESS_ARENA_SIZE -
+                    PANVK_GPU_PRERAST_TESS_DATA_OFFSET - 4 * 16) /
+                   panvk_gpu_prerast_tess_patch_bytes(tcs_stride_B);
+   uint64_t vs =
+      panvk_gpu_prerast_record_capacity(vs_record_stride) / MAX2(patch_size, 1);
+   return MIN2(tess, vs);
+}
+
+static inline void
+panvk_gpu_prerast_tess_layout(uint64_t arena, uint32_t patches,
+                              uint32_t tcs_stride_B,
+                              struct panvk_gpu_prerast_tess_layout *l)
+{
+   uint64_t off = arena + PANVK_GPU_PRERAST_TESS_DATA_OFFSET;
+
+   l->tcs = off;
+   off += ALIGN_POT((uint64_t)patches * tcs_stride_B, 16);
+   l->counts = off;
+   off += ALIGN_POT((uint64_t)patches * sizeof(uint32_t), 16);
+   l->coord_allocs = off;
+   off += ALIGN_POT((uint64_t)patches * sizeof(uint32_t), 16);
+   l->heap = off;
+   l->heap_size = patches * (PANVK_GPU_PRERAST_TESS_MAX_POINTS *
+                                sizeof(struct poly_tess_point) + 16) + 16;
+   off += l->heap_size;
+   l->index = off;
+   l->index_size =
+      patches * PANVK_GPU_PRERAST_TESS_MAX_INDICES * sizeof(uint32_t);
+   assert(off + l->index_size <= arena + PANVK_GPU_PRERAST_TESS_ARENA_SIZE);
+}
+
+struct panvk_gpu_prerast_arena {
+   uint32_t _pad[16];
+   struct panvk_gpu_prerast_params params;
+   uint8_t data[];
+};
+
+/* Ownership syncs of the two arenas, {seqno, error} CQS pairs taken on the
+ * compute subqueue and given back on the vertex/tiler one. Each subqueue is
+ * its own CSG on kbase, and kbase re-evaluates the SYNC_WAIT of an evicted
+ * CSG through a kernel mapping that only CSF event memory has. A wait on any
+ * other memory never wakes up once its group is suspended.
+ */
+struct panvk_gpu_prerast_syncs {
+   uint32_t arena[2];
+   uint32_t tess_arena[2];
+   /* panvk_device::gpu_prerast_tess_arena2 (csf-v11 tess-arenas). */
+   uint32_t tess_arena2[2];
+};
+
+struct panvk_gpu_prerast_sync_contract {
+   VkPipelineStageFlags2 producer_stages;
+   VkAccessFlags2 producer_access;
+   VkPipelineStageFlags2 internal_consumer_stages;
+   VkAccessFlags2 internal_consumer_access;
+};
+
+struct panvk_gpu_prerast_contract {
+   enum panvk_gpu_prerast_side_effect_policy side_effect_policy;
+   enum panvk_gpu_prerast_lifetime scratch_lifetime;
+   enum panvk_gpu_prerast_render_scope render_scope;
+   enum panvk_gpu_prerast_output_order output_order;
+   enum panvk_gpu_prerast_state_isolation state_isolation;
+   struct panvk_gpu_prerast_sync_contract sync;
+};
+
+extern const struct panvk_gpu_prerast_contract
+panvk_per_arch(gpu_prerast_contract);
+
+static inline enum panvk_prerast_path
+panvk_gpu_prerast_select(uint32_t requirements, bool lowered_vs_compiled)
+{
+   return requirements && lowered_vs_compiled ? PANVK_PRERAST_GPU_LOWERED
+                                              : PANVK_PRERAST_HW_IDVS;
+}
+
+struct panvk_gpu_prerast_draw
+panvk_per_arch(gpu_prerast_draw_info)(const struct panvk_draw_info *draw);
+
+static inline bool
+panvk_gpu_prerast_checked_size(uint64_t count, uint64_t stride,
+                               uint64_t alignment, uint64_t *size)
+{
+   if (!alignment || (alignment & (alignment - 1)) ||
+       (count && stride > UINT64_MAX / count))
+      return false;
+
+   uint64_t bytes = count * stride;
+   if (bytes > UINT64_MAX - (alignment - 1))
+      return false;
+
+   *size = ALIGN_POT(bytes, alignment);
+   return true;
+}
+
+VkResult panvk_per_arch(gpu_prerast_validate_execution)(
+   const struct panvk_cmd_buffer *cmdbuf,
+   const struct panvk_gpu_prerast_execution *exec);
+
+enum panvk_gpu_prerast_poly_mode panvk_per_arch(gpu_prerast_poly_mode)(
+   const struct panvk_cmd_buffer *cmdbuf, const struct panvk_draw_info *draw);
+
+bool panvk_per_arch(gpu_prerast_can_lower)(
+   const struct panvk_cmd_buffer *cmdbuf, const struct panvk_draw_info *draw,
+   const struct panvk_gpu_prerast_shader *shader);
+
+#endif
diff --git a/src/panfrost/vulkan/panvk_gs.h b/src/panfrost/vulkan/panvk_gs.h
new file mode 100644
index 00000000000..c776602f055
--- /dev/null
+++ b/src/panfrost/vulkan/panvk_gs.h
@@ -0,0 +1,370 @@
+/*
+ * Copyright 2026 XclipseTools
+ * SPDX-License-Identifier: MIT
+ *
+ * Ported from JimVulkan/mesa-unified-drivers (Bifrost geometry stage
+ * emulation) by biblioklept.
+ */
+
+#ifndef PANVK_GS_H
+#define PANVK_GS_H
+
+/* Geometry stage emulation for Bifrost (v6/v7). Arch-independent on
+ * purpose: the lowering is pure NIR, and this header only carries the
+ * contract between it and the JM draw path.
+ */
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "compiler/shader_enums.h"
+
+struct nir_shader;
+struct nir_xfb_info;
+
+/* Mali has no geometry stage, so a geometry shader is compiled into a
+ * COMPUTE shader that runs between the vertex job and the tiler job: it
+ * reads the varying buffers the vertex shader wrote and writes a fresh set
+ * for the tiler, plus an index buffer expanding the strips it emitted into
+ * independent primitives. Output is sized for the worst case, see
+ * panvk_nir_lower_gs.c.
+ */
+#define PANVK_GS_WORKGROUP_SIZE 64
+#define PANVK_GS_SLOT_UNUSED    UINT32_MAX
+
+/* An indirect draw's parameters exist only on the GPU, so the emulation is
+ * dispatched for this many input primitives (times gl_InvocationID) and each
+ * invocation reads the real count from the draw's argument buffer.
+ * Primitives past the cap are dropped.
+ */
+#define PANVK_GS_INDIRECT_MAX_PRIMS 4096
+/* jm-v7 023: the real cap is PANVK_GS_INDIRECT_MAX_VERTS output vertices
+ * (growable memory) over the shader's output vertices per input primitive,
+ * clamped to [PANVK_GS_INDIRECT_MAX_PRIMS, PANVK_GS_INDIRECT_MAX_PRIMS_BIG].
+ */
+#define PANVK_GS_INDIRECT_MAX_VERTS     (1u << 22)
+#define PANVK_GS_INDIRECT_MAX_PRIMS_BIG (1u << 20)
+
+/* How the draw's vertices assemble into the input primitives. Lists, and
+ * the list-with-adjacency topologies, are LIST.
+ */
+enum panvk_gs_topology {
+   PANVK_GS_TOPO_LIST = 0,
+   /* primitive p is vertices p .. p + n - 1; triangle strips swap the last
+    * two on odd p */
+   PANVK_GS_TOPO_STRIP = 1,
+   /* triangle p is vertices p + 1, p + 2, 0 */
+   PANVK_GS_TOPO_FAN = 2,
+   /* triangle strip with adjacency, see gs_input_record() */
+   PANVK_GS_TOPO_TRI_STRIP_ADJ = 3,
+};
+
+/* Push-constant block the lowered shader reads its addresses from. Field
+ * order is load-bearing: panvk_nir_lower_gs.c addresses it with offsetof().
+ */
+struct panvk_gs_push {
+   uint64_t in_pos;
+   uint64_t in_general;
+   uint64_t out_pos;
+   uint64_t out_general;
+   uint64_t out_index;
+   /* slot -> byte offset in the generic buffer, indexed by gl_varying_slot,
+    * PANVK_GS_SLOT_UNUSED for a slot nothing reads. The input offsets
+    * belong to the vertex shader's layout and the output offsets to the
+    * fragment shader's, neither is known when the GS is compiled.
+    */
+   uint64_t in_offsets;
+   uint64_t out_offsets;
+   uint32_t in_general_stride;
+   uint32_t out_general_stride;
+   uint32_t num_input_prims;
+   uint32_t pad;
+   /* The viewport transform, applied by the emulation on the way out (and
+    * undone on the way in when the vertex shader already applied it).
+    * Padded to vec4. These cannot come from nir_load_viewport_*: this runs
+    * as COMPUTE with a compute sysval block.
+    */
+   float viewport_scale[3];
+   float pad2;
+   float viewport_offset[3];
+   float pad3;
+   /* Input assembly. The vertex shader wrote one varying record per vertex
+    * it ran, each instance's records at instance_stride after the previous
+    * one. index_buf is the draw's first index, or 0 for a plain draw.
+    */
+   uint64_t index_buf;
+   uint32_t index_size;
+   uint32_t topology;
+   uint32_t prims_per_instance;
+   uint32_t instance_stride;
+   /* Indirect draws (indirect_cmd != 0): the Vk*IndirectCommand, the vertex
+    * job's varying buffer descriptors as the draw helper patched them, its
+    * DRAW section (Instance Size is the per-instance record stride), and for
+    * an indexed draw the smallest index (the vertex job starts at it).
+    * index_buf is then the index buffer base. num_input_prims is the cap.
+    */
+   uint64_t indirect_cmd;
+   uint64_t in_pos_desc;
+   uint64_t in_general_desc;
+   uint64_t vertex_dcd;
+   uint64_t index_min;
+   /* The tiler job's PRIMITIVE index count word: the emulation writes the
+    * real count there.
+    */
+   uint64_t tiler_index_count;
+   /* Transform feedback, 0 when the draw is not capturing: one primitive
+    * count per compute invocation, and one staging record per output vertex
+    * slot in panvk_gs_xfb_table() order.
+    */
+   uint64_t xfb_counts;
+   uint64_t xfb_staging;
+   /* The polygon-mode geometry shader culls faces itself (PANVK_GS_CULL_*),
+    * since the tiler only sees the lines or points it emits.
+    */
+   uint32_t polygon_cull;
+   /* POSITION holds screen-space xyz and 1/w (the vertex shader was compiled
+    * for the tiler): the emulation undoes the viewport transform.
+    */
+   uint32_t in_screen_space;
+   /* A shader writing gl_ViewportIndex: PANVK_GS_MAX_VIEWPORTS entries of
+    * PANVK_GS_VIEWPORT_STRIDE bytes, {scale xyz, offset xyz, scissor
+    * min x, min y, max x, max y (floats, max exclusive)}. 0 otherwise.
+    */
+   uint64_t viewports;
+   /* Tessellation: the draw's struct poly_tess_params. */
+   uint64_t tess_params;
+   /* When non-zero, where the real number of input primitives is:
+    * min(*num_prims_addr, num_input_prims) run.
+    */
+   uint64_t num_prims_addr;
+   /* Vertices per input primitive when compiled for a variable count (the
+    * tess control stage: patchControlPoints).
+    */
+   uint32_t patch_size;
+   /* Leave output positions in clip space (tess eval feeding a GS). */
+   uint32_t out_clip_space;
+   /* geometryStreams: every stream owns a copy of the output vertex slots
+    * (xfb_stream_slots per stream) and its own index list and counts; only
+    * stream 0 is rasterized. xfb_stream_index holds the lists of streams
+    * 1-3, xfb_stream_idx entries each, and the counts of stream s start at
+    * s * xfb_invocations in xfb_counts.
+    */
+   uint64_t xfb_stream_index;
+   uint32_t xfb_stream_slots;
+   uint32_t xfb_stream_idx;
+   uint32_t xfb_invocations;
+   uint32_t pad4;
+   /* Pipeline statistics (jm-v7 016), 0 when no query counts: four u64
+    * counter addresses, each 0 when not counted, that every live invocation
+    * adds to: geometry shader invocations (1), geometry shader primitives
+    * (all streams), clipping invocations and clipping primitives (stream 0).
+    */
+   uint64_t pstats;
+   /* Per-viewport rasterization (jm-v7 031): when the selectable viewports'
+    * depth ranges differ, the tiler cannot clamp/clip with a union. vp_split
+    * viewports then each get a copy of the index list (index_region entries
+    * apart, after the full list at out_index) holding only their primitives,
+    * and a tiler job of their own. out_viewport holds the viewport index of
+    * every output vertex slot; the tiler jobs are tiler_job_stride bytes
+    * apart. vp_split 0: one tiler job with the union (jm-v7 017).
+    */
+   uint64_t out_viewport;
+   uint32_t vp_split;
+   uint32_t index_region;
+   uint32_t tiler_job_stride;
+   /* gl_PointSize (jm-v7 033): the vertex shader's fp16 point sizes,
+    * in_psiz_stride bytes apart (in_psiz 0: it writes none, reads 1.0; an
+    * indirect draw's buffer is in the patched descriptor in_psiz_desc), and
+    * the emulation's own for point output (0: none).
+    */
+   uint32_t in_psiz_stride;
+   uint64_t in_psiz;
+   uint64_t in_psiz_desc;
+   uint64_t out_psiz;
+};
+
+/* gl_ViewportIndex, carried from the emulation to the fragment shader in a
+ * slot Vulkan never uses and pan lays out as generic.
+ */
+#define PANVK_GS_VIEWPORT_INDEX_SLOT VARYING_SLOT_CLIP_VERTEX
+/* jm-v7 026: on v6/v7 a vertex shader's CULL_DIST0/1 hold the "cull < 0"
+ * flags the FS kill interpolates (panvk_lower_cull_dist_flags_intr()), not
+ * the distances. A VS or TES whose transform feedback captures
+ * gl_CullDistance also writes the raw distances to these two slots (unused
+ * by Vulkan, generic to pan, not passed on to the FS by the emulation), and
+ * its passthrough captures them from there.
+ */
+#define PANVK_XFB_RAW_CULL_SLOT0     VARYING_SLOT_TEX0
+#define PANVK_XFB_RAW_CULL_SLOT1     VARYING_SLOT_TEX1
+#define PANVK_GS_MAX_VIEWPORTS       16
+#define PANVK_GS_VIEWPORT_STRIDE     40
+
