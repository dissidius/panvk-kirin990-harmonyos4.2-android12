+
+static struct kbase_atom_slot *
+kbase_atom_alloc_try(struct kbase_kmod_dev *kd, struct pan_kmod_bo **bos,
+                      uint32_t nbo, uint32_t core_req, bool no_waiter)
+{
+   simple_mtx_lock(&kd->atoms_lock);
+   for (unsigned attempt = 0; attempt < 255; attempt++) {
+      uint64_t num = (kd->next_atom_number++ % 255) + 1;
+      bool used = false;
+
+      for (unsigned i = 0; i < KBASE_MAX_ATOMS; i++) {
+         if (kd->atoms[i].atom_number == num) {
+            used = true;
+            break;
+         }
+      }
+
+      if (used)
+         continue;
+
+      for (unsigned i = 0; i < KBASE_MAX_ATOMS; i++) {
+         if (!kd->atoms[i].atom_number) {
+            struct kbase_atom_slot *s = &kd->atoms[i];
+            s->atom_number = num;
+            s->completed = s->errored = false;
+            s->waiters = no_waiter ? 0 : 1;
+            s->core_req = core_req;
+            kd->atom_failed[num] = false;
+            kd->last_event_code[num] = 0;
+            kd->last_done_atom_ctx[num] = 0;
+            kd->last_done_code_ctx[num] = 0;
+            s->nbo = MIN2(nbo, ARRAY_SIZE(s->bos));
+            for (uint32_t j = 0; j < s->nbo; j++)
+               s->bos[j] = bos[j];
+            simple_mtx_unlock(&kd->atoms_lock);
+            return s;
+         }
+      }
+   }
+
+   simple_mtx_unlock(&kd->atoms_lock);
+   return NULL;
+}
+
+static void
+kbase_atom_process_event_locked(struct kbase_kmod_dev *kd,
+                                 const struct base_jd_event_v2 *ev)
+{
+   unsigned num = ev->atom_number;
+   bool errored = ev->event_code != BASE_JD_EVENT_DONE;
+   kd->last_event_code[num] = ev->event_code;
+   kd->atom_failed[num] = errored;
+   kd->last_done_atom_ctx[num] = num;
+   kd->last_done_code_ctx[num] = ev->event_code;
+
+   for (unsigned i = 0; i < KBASE_MAX_ATOMS; i++) {
+      if (num && kd->atoms[i].atom_number == num) {
+         struct kbase_atom_slot *s = &kd->atoms[i];
+         s->completed = true;
+         s->errored = errored;
+         if (errored)
+            mesa_loge("kbase: JM atom %u failed: event=0x%x core_req=0x%x",
+                      num, ev->event_code, s->core_req);
+         if (s->waiters == 0)
+            s->atom_number = 0;
+         return;
+      }
+   }
+
+   if (errored)
+      mesa_loge("kbase: untracked JM atom %u failed: event=0x%x",
+                num, ev->event_code);
+}
+
+static int
+kbase_drain_events(struct kbase_kmod_dev *kd, int timeout_ms)
+{
+   struct pollfd pfd = { .fd = kd->base.fd, .events = POLLIN };
+   int ret = poll(&pfd, 1, timeout_ms);
+   if (ret <= 0)
+      return ret < 0 && errno != EINTR ? -1 : 0;
+   if (!(pfd.revents & POLLIN))
+      return -1;
+
+   /* jm-v7 114: up to 16 events per read(). kbase_read() copies queued
+    * events while the buffer has room and returns as soon as the queue is
+    * empty once it has copied one, so a short read means the queue was
+    * drained and no further poll() is needed. Before, every event cost a
+    * poll() plus a read(). PANVK_KBASE_EVENT_BATCH=0 = one per read (old).
+    */
+   static int ev_batch = -1;
+   if (ev_batch < 0) {
+      const char *e = getenv("PANVK_KBASE_EVENT_BATCH");
+      ev_batch = !(e && e[0] == '0');
+   }
+   const unsigned max_ev = ev_batch ? 16 : 1;
+
+   simple_mtx_lock(&kd->atoms_read_lock);
+   for (unsigned i = 0; i < KBASE_MAX_ATOMS; i++) {
+      struct pollfd rfd = { .fd = kd->base.fd, .events = POLLIN };
+      ret = poll(&rfd, 1, 0);
+      if (ret <= 0) {
+         ret = ret < 0 && errno != EINTR ? -1 : 0;
+         break;
+      }
+      if (!(rfd.revents & POLLIN)) {
+         ret = -1;
+         break;
+      }
+
+      struct base_jd_event_v2 ev[16];
+      ssize_t n;
+      do {
+         n = read(kd->base.fd, ev, max_ev * sizeof(ev[0]));
+      } while (n < 0 && errno == EINTR);
+      if (n <= 0 || n % (ssize_t)sizeof(ev[0])) {
+         ret = -1;
+         break;
+      }
+
+      const unsigned got = n / sizeof(ev[0]);
+      simple_mtx_lock(&kd->atoms_lock);
+      for (unsigned j = 0; j < got; j++)
+         kbase_atom_process_event_locked(kd, &ev[j]);
+      simple_mtx_unlock(&kd->atoms_lock);
+      ret = 0;
+      if (got < max_ev)
+         break;
+   }
+   simple_mtx_unlock(&kd->atoms_read_lock);
+   return ret;
+}
+
+static unsigned
+kbase_reclaim_completed(struct kbase_kmod_dev *kd)
+{
+   unsigned n = 0;
+   simple_mtx_lock(&kd->atoms_lock);
+   for (unsigned i = 0; i < KBASE_MAX_ATOMS; i++) {
+      if (kd->atoms[i].atom_number && kd->atoms[i].completed) {
+         kd->atoms[i].atom_number = 0;
+         n++;
+      }
+   }
+   simple_mtx_unlock(&kd->atoms_lock);
+   return n;
+}
+
+static struct kbase_atom_slot *
+kbase_atom_alloc(struct kbase_kmod_dev *kd, struct pan_kmod_bo **bos,
+                 uint32_t nbo, uint32_t core_req, bool no_waiter)
+{
+   for (unsigned tries = 0; tries < 10000; tries++) {
+      struct kbase_atom_slot *s =
+         kbase_atom_alloc_try(kd, bos, nbo, core_req, no_waiter);
+      if (s)
+         return s;
+      if (kbase_drain_events(kd, 0) < 0)
+         return NULL;
+      if (!kbase_reclaim_completed(kd) && kbase_drain_events(kd, 1) < 0)
+         return NULL;
+   }
+
+   mesa_loge("kbase: JM atom table is full");
+   return NULL;
+}
+
+static bool
+kbase_wait_atom(struct kbase_kmod_dev *kd, uint64_t atom_num,
+                 int64_t timeout_ns)
+{
+   if (!atom_num)
+      return true;
+   if (atom_num >= KBASE_MAX_ATOMS) {
+      errno = EINVAL;
+      return false;
+   }
+
+   int64_t deadline = timeout_ns < 0 ? -1 :
+                      os_time_get_absolute_timeout(timeout_ns);
+   if (kbase_drain_events(kd, 0) < 0)
+      return false;
+
+   for (;;) {
+      simple_mtx_lock(&kd->atoms_lock);
+      bool present = false;
+      for (unsigned i = 0; i < KBASE_MAX_ATOMS; i++) {
+         struct kbase_atom_slot *s = &kd->atoms[i];
+         if (s->atom_number != atom_num)
+            continue;
+         present = true;
+         if (s->completed) {
+            bool ok = !s->errored;
+            if (s->waiters > 0 && --s->waiters == 0)
+               s->atom_number = 0;
+            simple_mtx_unlock(&kd->atoms_lock);
+            return ok;
+         }
+         break;
+      }
+
+      if (!present) {
+         if (kd->atom_failed[atom_num]) {
+            simple_mtx_unlock(&kd->atoms_lock);
+            return false;
+         }
+         if (kd->last_done_atom_ctx[atom_num] == atom_num) {
+            bool ok = kd->last_done_code_ctx[atom_num] == BASE_JD_EVENT_DONE;
+            simple_mtx_unlock(&kd->atoms_lock);
+            return ok;
+         }
+      }
+      simple_mtx_unlock(&kd->atoms_lock);
+
+      if (deadline >= 0 && os_time_get_nano() >= deadline)
+         return false;
+      if (kbase_drain_events(kd, 1) < 0)
+         return false;
+   }
+}
+
+uint64_t
+kbase_kmod_job_submit(struct pan_kmod_dev *dev, uint64_t jc,
+                      uint32_t core_req, struct pan_kmod_bo **bos,
+                      uint32_t nbo, struct base_external_resource *ext_res,
+                      uint32_t next_res)
+{
+   struct kbase_kmod_dev *kd = container_of(dev, struct kbase_kmod_dev, base);
+   if (kd->is_csf) {
+      errno = ENOTSUP;
+      return 0;
+   }
+   if (ext_res && next_res > UINT16_MAX) {
+      errno = EINVAL;
+      return 0;
+   }
+
+   struct kbase_atom_slot *slot =
+      kbase_atom_alloc(kd, bos, nbo, core_req, false);
+   if (!slot)
+      return 0;
+
+   struct base_jd_atom atom = {
+      .jc = jc,
+      .core_req = core_req,
+      .atom_number = (uint8_t)slot->atom_number,
+   };
+   if (ext_res && next_res) {
+      atom.extres_list = (uintptr_t)ext_res;
+      atom.nr_extres = (uint16_t)next_res;
+      atom.core_req |= BASE_JD_REQ_EXTERNAL_RESOURCES;
+   }
+
+   struct {
+      __u64 seq_nr;
+      struct base_jd_atom atom;
+   } w = { .atom = atom };
+   struct kbase_ioctl_job_submit sub = {
+      .addr = kd->atom_seq_nr ? (uintptr_t)&w : (uintptr_t)&atom,
+      .nr_atoms = 1,
+      .stride = kd->atom_stride,
+   };
+   if (ioctl(dev->fd, KBASE_IOCTL_JOB_SUBMIT, &sub) < 0) {
+      mesa_loge("kbase: JOB_SUBMIT failed: %s", strerror(errno));
+      simple_mtx_lock(&kd->atoms_lock);
+      slot->atom_number = 0;
+      simple_mtx_unlock(&kd->atoms_lock);
+      return 0;
+   }
+   return atom.atom_number;
+}
+
+uint64_t
+kbase_kmod_job_submit_dep(struct pan_kmod_dev *dev, uint64_t jc,
+                          uint32_t core_req, struct pan_kmod_bo **bos,
+                          uint32_t nbo, uint64_t dep0, uint8_t dep0_type,
+                          uint64_t dep1, uint8_t dep1_type, bool no_waiter)
+{
+   struct kbase_kmod_dev *kd = container_of(dev, struct kbase_kmod_dev, base);
+   if (kd->is_csf) {
+      errno = ENOTSUP;
+      return 0;
+   }
+
+   struct kbase_atom_slot *slot =
+      kbase_atom_alloc(kd, bos, nbo, core_req, no_waiter);
+   if (!slot)
+      return 0;
+
+   struct base_jd_atom atom = {
+      .jc = jc,
+      .core_req = core_req,
+      .atom_number = (uint8_t)slot->atom_number,
+   };
+   uint64_t deps[2] = { dep0, dep1 };
+   uint8_t types[2] = { dep0_type, dep1_type };
+   if (deps[1] == deps[0])
+      deps[1] = 0;
+   for (unsigned i = 0; i < 2; i++) {
+      bool use = deps[i] && types[i] && deps[i] != atom.atom_number;
+      atom.pre_dep[i].atom_id = use ? (uint8_t)deps[i] : 0;
+      atom.pre_dep[i].dependency_type = use ? types[i] : 0;
+   }
+
+   struct {
+      __u64 seq_nr;
+      struct base_jd_atom atom;
+   } w = { .atom = atom };
+   struct kbase_ioctl_job_submit sub = {
+      .addr = kd->atom_seq_nr ? (uintptr_t)&w : (uintptr_t)&atom,
+      .nr_atoms = 1,
+      .stride = kd->atom_stride,
+   };
+   if (ioctl(dev->fd, KBASE_IOCTL_JOB_SUBMIT, &sub) < 0) {
+      mesa_loge("kbase: JOB_SUBMIT(dep) failed: %s", strerror(errno));
+      simple_mtx_lock(&kd->atoms_lock);
+      slot->atom_number = 0;
+      simple_mtx_unlock(&kd->atoms_lock);
+      return 0;
+   }
+   return atom.atom_number;
+}
+
+void
+kbase_kmod_atom_release(struct pan_kmod_dev *dev, uint64_t atom_num)
+{
+   struct kbase_kmod_dev *kd = container_of(dev, struct kbase_kmod_dev, base);
+   if (kd->is_csf) {
+      errno = ENOTSUP;
+      return;
+   }
+   if (!atom_num)
+      return;
+
+   simple_mtx_lock(&kd->atoms_lock);
+   for (unsigned i = 0; i < KBASE_MAX_ATOMS; i++) {
+      struct kbase_atom_slot *s = &kd->atoms[i];
+      if (s->atom_number != atom_num)
+         continue;
+      if (s->waiters > 0)
+         s->waiters--;
+      if (s->waiters == 0 && s->completed)
+         s->atom_number = 0;
+      break;
+   }
+   simple_mtx_unlock(&kd->atoms_lock);
+}
+
+bool
+kbase_kmod_job_submit_retry(struct pan_kmod_dev *dev, uint64_t jc,
+                            uint32_t core_req, struct pan_kmod_bo **bos,
+                            uint32_t nbo, struct base_external_resource *ext_res,
+                            uint32_t next_res, int max_attempts)
+{
+   struct kbase_kmod_dev *kd = container_of(dev, struct kbase_kmod_dev, base);
+   if (kd->is_csf) {
+      errno = ENOTSUP;
+      return false;
+   }
+
+   for (int attempt = 0; attempt < max_attempts; attempt++) {
+      uint64_t atom = kbase_kmod_job_submit(dev, jc, core_req, bos, nbo,
+                                           ext_res, next_res);
+      if (!atom)
+         return false;
+      if (kbase_kmod_wait_atom(dev, atom, -1))
+         return true;
+
+      if (attempt + 1 < max_attempts) {
+         int64_t delay_ms = 400ll * (attempt + 1);
+         struct timespec ts = {
+            .tv_sec = delay_ms / 1000,
+            .tv_nsec = (delay_ms % 1000) * 1000000,
+         };
+         while (nanosleep(&ts, &ts) && errno == EINTR)
+            ;
+      }
+   }
+   return false;
+}
+
+/* Clean the CPU caches of every non-coherent CPU-mapped dma-buf import
+ * (see kbase_kmod_import_dmabuf()) so GPU work submitted next sees the CPU's
+ * writes. DMA_BUF_IOCTL_SYNC END makes the exporter sync its device
+ * attachments, kbase's included. ponytail: whole buffers on every submit;
+ * track dirty mappings if this shows up in profiles. */
+void
+kbase_kmod_jm_clean_imports(struct pan_kmod_dev *dev)
+{
+   struct kbase_kmod_dev *kd = container_of(dev, struct kbase_kmod_dev, base);
+
+   simple_mtx_lock(&kd->nc_lock);
+   list_for_each_entry(struct kbase_kmod_bo, bo, &kd->nc_bos, nc_link) {
+      struct dma_buf_sync sync = {
+         .flags = DMA_BUF_SYNC_END | DMA_BUF_SYNC_WRITE,
+      };
+      int ret;
+      do {
+         ret = ioctl(bo->dmabuf_fd, DMA_BUF_IOCTL_SYNC, &sync);
+      } while (ret && (errno == EINTR || errno == EAGAIN));
+      if (ret)
+         mesa_logw_once("kbase: DMA_BUF_IOCTL_SYNC failed: %s",
+                        strerror(errno));
+   }
+   simple_mtx_unlock(&kd->nc_lock);
+}
+
+bool
+kbase_kmod_wait_atom(struct pan_kmod_dev *dev, uint64_t atom_number,
+                     int64_t timeout_ns)
+{
+   struct kbase_kmod_dev *kd = container_of(dev, struct kbase_kmod_dev, base);
+   if (kd->is_csf) {
+      errno = ENOTSUP;
+      return false;
+   }
+   return kbase_wait_atom(kd, atom_number, timeout_ns);
+}
+
+const struct pan_kmod_ops kbase_kmod_ops = {
+   .dev_create             = kbase_kmod_dev_create,
+   .dev_destroy            = kbase_kmod_dev_destroy,
+   .dev_query_user_va_range = kbase_kmod_dev_query_user_va_range,
+   .bo_alloc               = kbase_kmod_bo_alloc,
+   .bo_free                = kbase_kmod_bo_free,
+   .bo_import              = kbase_kmod_bo_import,
+   .bo_export              = kbase_kmod_bo_export,
+   .bo_mmap                = kbase_kmod_bo_mmap,
+   .bo_munmap              = kbase_kmod_bo_munmap,
+   .flush_bo_map_syncs     = kbase_kmod_flush_bo_map_syncs,
+   .cs_event_signal        = kbase_kmod_cs_event_signal,
+   .bo_wait                = kbase_kmod_bo_wait,
+   .bo_make_evictable      = kbase_kmod_bo_make_evictable,
+   .bo_make_unevictable    = kbase_kmod_bo_make_unevictable,
+   .vm_create              = kbase_kmod_vm_create,
+   .vm_destroy             = kbase_kmod_vm_destroy,
+   .vm_bind                = kbase_kmod_vm_bind,
+   .vm_query_state         = kbase_kmod_vm_query_state,
+   .query_timestamp        = kbase_kmod_query_timestamp,
+   .bo_set_label           = kbase_kmod_bo_set_label,
+};
diff --git a/src/panfrost/lib/kmod/kbase_kmod.h b/src/panfrost/lib/kmod/kbase_kmod.h
new file mode 100644
index 00000000000..4020bcc83dd
--- /dev/null
+++ b/src/panfrost/lib/kmod/kbase_kmod.h
@@ -0,0 +1,188 @@
+/*
+ * Copyright © 2026 Collabora, Ltd.
+ * SPDX-License-Identifier: MIT
+ */
+
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#if defined(__cplusplus)
+extern "C" {
+#endif
+
+struct drm_panthor_csif_info;
+
+struct pan_kmod_dev;
+struct pan_kmod_bo;
+
+struct base_external_resource {
+   uint64_t ext_resource;
+};
+
+#define BASE_JD_DEP_TYPE_DATA 1
+#define BASE_JD_DEP_TYPE_ORDER 2
+
+#define BASE_JD_REQ_FS                 (1u << 0)
+#define BASE_JD_REQ_CS                 (1u << 1)
+#define BASE_JD_REQ_T                  (1u << 2)
+#define BASE_JD_REQ_CF                 (1u << 3)
+#define BASE_JD_REQ_V                  (1u << 4)
+/* Keeps the GPU timestamp counter running while the atom runs (JM). */
+#define BASE_JD_REQ_PERMON             (1u << 7)
+#define BASE_JD_REQ_EXTERNAL_RESOURCES (1u << 8)
+#define BASE_JD_REQ_ONLY_COMPUTE       (1u << 10)
+
+uint64_t kbase_kmod_job_submit(struct pan_kmod_dev *dev, uint64_t jc,
+                              uint32_t core_req, struct pan_kmod_bo **bos,
+                              uint32_t nbo,
+                              struct base_external_resource *ext_res,
+                              uint32_t next_res);
+uint64_t kbase_kmod_job_submit_dep(struct pan_kmod_dev *dev, uint64_t jc,
+                                  uint32_t core_req, struct pan_kmod_bo **bos,
+                                  uint32_t nbo, uint64_t dep0, uint8_t dep0_type,
+                                  uint64_t dep1, uint8_t dep1_type,
+                                  bool no_waiter);
+bool kbase_kmod_job_submit_retry(struct pan_kmod_dev *dev, uint64_t jc,
+                                uint32_t core_req, struct pan_kmod_bo **bos,
+                                uint32_t nbo,
+                                struct base_external_resource *ext_res,
+                                uint32_t next_res, int max_attempts);
+bool kbase_kmod_wait_atom(struct pan_kmod_dev *dev, uint64_t atom_number,
+                         int64_t timeout_ns);
+void kbase_kmod_atom_release(struct pan_kmod_dev *dev, uint64_t atom_num);
+void kbase_kmod_jm_clean_imports(struct pan_kmod_dev *dev);
+struct pan_kmod_bo *kbase_kmod_bo_import_host(struct pan_kmod_dev *dev,
+                                            void *host_ptr, uint64_t size);
+
+/* CSF interface information for a kbase CSF device, presented in the
+ * panthor uAPI layout so CSF-generic code can consume either backend.
+ * Filled from KBASE_IOCTL_CS_GET_GLB_IFACE at device-create time.
+ * Only valid for CSF (arch >= 10) kbase devices.
+ */
+const struct drm_panthor_csif_info *
+kbase_kmod_get_csif_props(const struct pan_kmod_dev *dev);
+
+/* Current LATEST_FLUSH value from the CSF USER register page (the kbase
+ * equivalent of panthor_kmod_get_flush_id()). */
+uint32_t kbase_kmod_get_flush_id(const struct pan_kmod_dev *dev);
+
+/* True when this kbase context can allocate dma-bufs for sharing with WSI. */
+bool kbase_kmod_supports_dmabuf(const struct pan_kmod_dev *dev);
+
+/* CSF queue group / queue / tiler heap primitives (CSF only).
+ *
+ * A queue is a ring buffer in a GPU BO: bind it to a group at a CS index,
+ * mmap the returned USER_IO pages (doorbell / input / output), write CS
+ * instructions into the ring, publish the new insert offset in the input
+ * page and kick.  Progress is visible through CS_EXTRACT / CS_ACTIVE in
+ * the output page.
+ */
+int kbase_kmod_csf_group_create(struct pan_kmod_dev *dev,
+                                uint32_t cs_queue_count,
+                                uint32_t *group_handle);
+
+/* kbase counts va_pages, alias lengths and mmap handle offsets in kernel
+ * (CPU) pages: 4 KiB or 16 KiB.  Cached sysconf(_SC_PAGESIZE). */
+uint64_t kbase_kmod_page_size(void);
+
+/* CSF uAPI layouts, named by ioctl size in bytes (public
+ * mali_kbase_csf_ioctl.h, r3x-r5x):
+ *  CS_QUEUE_GROUP_CREATE: 32 = _1_6 (nr 42, all CSF uAPIs),
+ *    40 = _1_18 (nr 58, 1.7+; csi_handlers 1.12+), 112 = current (nr 58,
+ *    1.19+; cs_fault_report_enable 1.25+).
+ *  CS_TILER_HEAP_INIT: 16 = _1_13 (all), 24 = + buf_desc_va (1.14+).
+ * Newer kernels keep the older layouts as compat cases, so the
+ * device-proven layout goes first and the others are tried on
+ * EINVAL/ENOTTY in the order returned. */
+static inline unsigned
+kbase_csf_group_create_layouts(unsigned major, unsigned minor,
+                               unsigned out[3])
+{
+   const unsigned v = major * 1000 + minor;
+   unsigned n = 0;
+
+   if (v >= 1025)
+      out[n++] = 112;
+   out[n++] = 32;
+   if (v >= 1019 && v < 1025)
+      out[n++] = 112;
+   if (v >= 1007)
+      out[n++] = 40;
+   return n;
+}
+
+static inline unsigned
+kbase_csf_tiler_heap_init_layouts(unsigned major, unsigned minor,
+                                  unsigned out[2])
+{
+   unsigned n = 0;
+
+   out[n++] = 16;
+   if (major * 1000 + minor >= 1014)
+      out[n++] = 24;
+   return n;
+}
+void kbase_kmod_csf_group_destroy(struct pan_kmod_dev *dev,
+                                  uint32_t group_handle);
+
+/* Registers and binds the ring buffer at ringbuf_va; returns the mmap()ed
+ * USER_IO pages (BASEP_QUEUE_NR_MMAP_USER_PAGES) or NULL on failure. */
+void *kbase_kmod_csf_queue_bind(struct pan_kmod_dev *dev,
+                                uint32_t group_handle, uint32_t csi_index,
+                                uint64_t ringbuf_va, uint32_t ringbuf_size);
+void kbase_kmod_csf_queue_term(struct pan_kmod_dev *dev, uint64_t ringbuf_va,
+                               void *user_io);
+int kbase_kmod_csf_queue_kick(struct pan_kmod_dev *dev, uint64_t ringbuf_va);
+
+/* Block (up to timeout_ns) until the kernel has a CSF notification, then
+ * consume one notification with read().  Lets the kernel event/OOM/
+ * scheduler path make progress while userspace waits for completion.
+ * Returns 0 on success (event consumed or timeout), -1 on error. */
+int kbase_kmod_csf_wait_event(struct pan_kmod_dev *dev, int64_t timeout_ns);
+
+/* Wait for a 64-bit CSF event object to become greater than target_minus_one
+ * using a kernel CPU queue and a sync_file fence.  The event address must
+ * refer to a 16-byte-aligned BASE_MEM_CSF_EVENT allocation.  Returns 1 when
+ * satisfied, 0 on timeout, and -1 when the path is unavailable so callers can
+ * retain their notification/read fallback. */
+int kbase_kmod_csf_wait_cqs64(struct pan_kmod_dev *dev, uint64_t addr,
+                              uint64_t target_minus_one,
+                              int64_t timeout_ns);
+
+int kbase_kmod_csf_export_cqs64_fence(struct pan_kmod_dev *dev,
+                                      const uint64_t *addrs,
+                                      const uint64_t *targets_minus_one,
+                                      unsigned count);
+
+/* Report whether this kbase context has seen a queue-group error.  The error
+ * state is latched while completion waits consume the notification stream. */
+bool kbase_kmod_csf_has_error(const struct pan_kmod_dev *dev);
+
+int kbase_kmod_csf_tiler_heap_create(struct pan_kmod_dev *dev,
+                                     uint32_t chunk_size,
+                                     uint32_t initial_chunks,
+                                     uint32_t max_chunks,
+                                     uint32_t target_in_flight,
+                                     uint32_t mem_group_id,
+                                     uint64_t *heap_ctx_va,
+                                     uint64_t *first_chunk_va);
+void kbase_kmod_csf_tiler_heap_destroy(struct pan_kmod_dev *dev,
+                                       uint64_t heap_ctx_va);
+
+/* Map a (GPU-cached, SAME_VA) BO `nents` times back-to-back at a single
+ * VA using KBASE_IOCTL_MEM_ALIAS — the kbase substitute for mapping one
+ * BO at several chosen addresses (used for wraparound ring buffers).
+ * The kernel picks the address (kbase rejects address hints); the
+ * mapping is guaranteed not to cross a 4G boundary.  Returns the base VA
+ * of the repeated mapping (CPU == GPU), or 0 on failure.  Release with
+ * kbase_kmod_alias_destroy(). */
+uint64_t kbase_kmod_alias_create(struct pan_kmod_dev *dev, uint64_t bo_va,
+                                 uint64_t size, uint32_t nents);
+void kbase_kmod_alias_destroy(struct pan_kmod_dev *dev, uint64_t va,
+                              uint64_t size, uint32_t nents);
+
+#if defined(__cplusplus)
+} // extern "C"
+#endif
