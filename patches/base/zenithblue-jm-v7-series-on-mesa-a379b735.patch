+   const bool array = nir_intrinsic_image_array(intr);
+   if (dim == GLSL_SAMPLER_DIM_MS || dim == GLSL_SAMPLER_DIM_SUBPASS ||
+       dim == GLSL_SAMPLER_DIM_SUBPASS_MS)
