+   off_t size = 0;
+   uint8_t *map = MAP_FAILED;
+   int lr = -1;
+   void *cpu = NULL;
+   unsigned match = 0;
+   const uint32_t xs[3] = { 0, d->width / 2, d->width - 1 };
+   const uint32_t ys[3] = { 0, d->height / 2, d->height - 1 };
