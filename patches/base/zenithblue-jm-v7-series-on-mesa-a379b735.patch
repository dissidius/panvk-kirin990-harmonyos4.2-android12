diff --git a/src/util/u_queue.c b/src/util/u_queue.c
index 13659c7720d..fd5f10d608b 100644
--- a/src/util/u_queue.c
+++ b/src/util/u_queue.c
@@ -34,6 +34,12 @@
 #include "util/timespec.h"
 #include "u_process.h"
 
+#include "util/detect_os.h"
+
+#if DETECT_OS_POSIX
+#include <pthread.h>
+#endif
+
 #if defined(__linux__)
 #include <sys/time.h>
