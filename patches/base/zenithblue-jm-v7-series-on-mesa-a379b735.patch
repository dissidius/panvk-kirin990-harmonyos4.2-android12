+       !d->width || !d->height || d->stride < d->width ||
+       (d->format != AHARDWAREBUFFER_FORMAT_R8G8B8A8_UNORM &&
+        d->format != AHARDWAREBUFFER_FORMAT_R8G8B8X8_UNORM) ||
+       !(d->usage & AHARDWAREBUFFER_USAGE_CPU_READ_MASK)) {
+      why = "unsupported desc";
