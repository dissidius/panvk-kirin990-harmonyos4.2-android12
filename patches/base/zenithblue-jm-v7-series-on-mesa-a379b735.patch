+   nir_def *coords = intr->src[1].ssa;
+   nir_def *size = nir_image_deref_size(b, nsize, 32, intr->src[0].ssa,
+                                        nir_imm_int(b, 0), .image_dim = dim,
+                                        .image_array = array);
