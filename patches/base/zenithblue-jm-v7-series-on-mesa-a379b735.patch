+      const uint32_t n = i - run_start;
+      const uint32_t ppi = v7_gs_restart_ppi(topology, vpp, n);
+      for (uint32_t p = 0; p < ppi && prims < max_prims; p++, prims++) {
+         for (uint32_t k = 0; k < vpp; k++) {
