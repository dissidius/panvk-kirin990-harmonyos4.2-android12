+
+#if PAN_ARCH == 9
+/* panlib_v9_prerast_indirect() parameters. Addresses are 0 when unused. */
+struct panlib_v9_prerast_patch {
+   /* VkDraw(Indexed)IndirectCommand and the vkCmdDraw*IndirectCount count. */
+   uint64_t cmd;
+   uint64_t draw_count;
+   /* panvk_gpu_prerast_params: &vertex_count (instance_count and
+    * first_instance follow, index_offset is 5 words on) and
+    * &vertex.verts_per_instance. */
+   uint64_t counts;
+   uint64_t verts_per_instance;
+   /* Lowered VS COMPUTE job and its first vertex / base instance sysvals. */
+   uint64_t vs_job;
+   uint64_t first_vertex_sysval;
+   uint64_t base_instance_sysval;
+   /* VS attribute descriptors and {offset, stride, divisor} of the
+    * instance-rate attributes with a divisor, see
+    * panlib_v9_draw_indirect_patch(). */
+   uint64_t vs_attribs;
+   uint64_t inst_attr_info;
+   /* GS kernel COMPUTE job and panvk_gpu_prerast_gs_params::vertex_count. */
+   uint64_t gs_job;
+   uint64_t gs_counts;
+   /* VkDrawIndexedIndirectCommand of the generated draw (VS only). */
+   uint64_t gen_draw;
+   /* {vertex, instance} start of a tessellation chunk, copied to
+    * panvk_gpu_prerast_params::chunk_vertex/_instance, or 0. */
+   uint64_t chunk;
+   uint32_t indexed;
+   uint32_t draw_index;
+   uint32_t capacity;
+   uint32_t inst_attr_mask;
+   uint32_t gs_invocations;
+   uint32_t _pad;
 };
 #endif
diff --git a/src/panfrost/libpan/draw_helper_vp.h b/src/panfrost/libpan/draw_helper_vp.h
new file mode 100644
index 00000000000..ec8d4a247c5
--- /dev/null
+++ b/src/panfrost/libpan/draw_helper_vp.h
@@ -0,0 +1,60 @@
+/*
+ * Copyright 2026 Abhay Byte
+ * SPDX-License-Identifier: MIT
+ */
+
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define PANLIB_VP_RUN_HEADER_BYTES 12u
+#define PANLIB_VP_RUN_BYTES 12u
+#define PANLIB_VP_MAX_VIEWPORTS 16u
+#define PANLIB_VP_RESTART 0xffffffffu
+/* pack_prim_id: run index = record | (primitive ID & 0xffff) << 16. Records
+ * are capped at 65536 (PANVK_GPU_PRERAST_MAX_INVOCATIONS). Run draws have
+ * primitive restart off, so any value is a vertex.
+ */
+#define PANLIB_VP_PRIM_ID_SHIFT 16u
+#define PANLIB_VP_PACKED_RECORD_MASK 0xffffu
+#define PANLIB_VP_MAX_INPUT_INDICES (1u << 24)
+#define PANLIB_VP_MAX_OUT_INDICES (1u << 24)
+#define PANLIB_VP_MAX_RUNS ((UINT32_MAX - PANLIB_VP_RUN_HEADER_BYTES) / PANLIB_VP_RUN_BYTES)
+
+struct panlib_vp_run {
+   uint32_t viewport;
+   uint32_t first_index;
+   uint32_t index_count;
+};
+
+struct panlib_vp_run_header {
+   uint32_t index_count;
+   uint32_t run_count;
+   uint32_t overflow;
+};
+
+/* Selected-viewport depth clamp, two little-endian floats. The run loop
+ * walks this with an immediate subtract: v11 cannot add a shifted
+ * viewport to a base address.
+ */
+struct panlib_vp_clamp {
+   float z_min;
+   float z_max;
+};
+
+/* The kernel argument struct is emitted by the libpan shader generator
+ * from panlib_vp_runs_launch. outputs_written is the GS mask before the
+ * passthrough drops the viewport bit.
+ */
+
+static inline bool
+panlib_vp_run_bytes(uint32_t run_capacity, uint64_t *bytes)
+{
+   if (run_capacity > PANLIB_VP_MAX_RUNS)
+      return false;
+
+   *bytes = PANLIB_VP_RUN_HEADER_BYTES +
+            (uint64_t)run_capacity * PANLIB_VP_RUN_BYTES;
+   return true;
+}
diff --git a/src/panfrost/libpan/fan_chunks.cl b/src/panfrost/libpan/fan_chunks.cl
new file mode 100644
index 00000000000..f51210b697f
--- /dev/null
+++ b/src/panfrost/libpan/fan_chunks.cl
@@ -0,0 +1,343 @@
+/*
+ * Copyright 2026 Abhay Byte
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "compiler/libcl/libcl.h"
+#include "compiler/libcl/libcl_vk.h"
+#include "compiler/shader_enums.h"
+#include "genxml/gen_macros.h"
+#include "fan_chunks.h"
+#include "tess_draw.h"
+
+#if PAN_ARCH >= 10
+
+#define FAN_WG 256
+
+/* Index at position pos of the API draw (from firstIndex). Restart indices
+ * and indices past the buffer read as restart when restart is on, past the
+ * buffer as 0 otherwise.
+ */
+static uint32_t
+fan_index(global struct panlib_chunk_draw *c, uint32_t pos, bool *restart)
+{
+   uint64_t at = (uint64_t)c->in_draw[2] + pos;
+
+   *restart = false;
+   if (at >= c->index_count_el) {
+      *restart = c->restart;
+      return 0;
+   }
+
+   uintptr_t addr = (uintptr_t)(c->index_buffer + at * c->index_size);
+   uint32_t v, rv;
+
+   if (c->index_size == 4) {
+      v = *(global uint32_t *)addr;
+      rv = 0xffffffff;
+   } else if (c->index_size == 2) {
+      v = *(global uint16_t *)addr;
+      rv = 0xffff;
+   } else {
+      v = *(global uint8_t *)addr;
+      rv = 0xff;
+   }
+
+   *restart = c->restart && v == rv;
+   return v;
+}
+
+static bool
+fan_is_restart(global struct panlib_chunk_draw *c, uint32_t pos)
+{
+   bool r;
+   fan_index(c, pos, &r);
+   return r;
+}
+
+struct fan_scan {
+   /* Last restart position, UINT32_MAX if none. */
+   uint32_t last;
+   /* Triangles of the fans that a restart ends. */
+   uint32_t closed;
+   /* Vertices after the last restart. */
+   uint32_t run;
+};
+
+/* Restart scan of [start, start + len) with the whole workgroup, like
+ * chunk_scan() in draw_helper.cl. Every invocation gets the same result.
+ */
+static struct fan_scan
+fan_scan(global struct panlib_chunk_draw *c, uint32_t start, uint32_t len,
+         local uint32_t *tmp)
+{
+   const uint32_t tid = cl_local_id.x;
+   const uint32_t seg = (len + FAN_WG - 1) / FAN_WG;
+   const uint32_t b = min(tid * seg, len), e = min(b + seg, len);
+   uint32_t last = UINT32_MAX, lead = 0, inner = 0, run = 0;
+
+   for (uint32_t j = b; j < e; j++) {
+      if (fan_is_restart(c, start + j)) {
+         if (last == UINT32_MAX)
+            lead = run;
+         else
+            inner += u_decomposed_prims_for_vertices(MESA_PRIM_TRIANGLE_FAN,
+                                                     run);
+         last = j;
+         run = 0;
+      } else {
+         run++;
+      }
+   }
+
+   tmp[tid] = last;
+   tmp[FAN_WG + tid] = lead;
+   tmp[2 * FAN_WG + tid] = inner;
+   tmp[3 * FAN_WG + tid] = run;
+   barrier(CLK_LOCAL_MEM_FENCE);
+
+   struct fan_scan r = {UINT32_MAX, 0, 0};
+   for (uint32_t t = 0; t < FAN_WG; t++) {
+      if (tmp[t] == UINT32_MAX) {
+         r.run += tmp[3 * FAN_WG + t];
+      } else {
+         r.closed += u_decomposed_prims_for_vertices(
+                        MESA_PRIM_TRIANGLE_FAN, r.run + tmp[FAN_WG + t]) +
+                     tmp[2 * FAN_WG + t];
+         r.run = tmp[3 * FAN_WG + t];
+         r.last = start + tmp[t];
+      }
+   }
+   barrier(CLK_LOCAL_MEM_FENCE);
+   return r;
+}
+
+/* panlib_chunk_step() for triangle fans. Plans the next chunk of the draw
+ * into c->draw (always the 5-word indexed layout: the chunk is drawn from
+ * f->indices) and f->c_*, which panlib_fan_chunk_fill() turns into indices.
+ *
+ * Whole instances when an instance fits max_verts (at most
+ * PANLIB_CHUNK_MAX_INSTANCES). Else a window of one instance:
+ * - no cut fan: positions [i, i + max_verts), hub i;
+ * - after a cut: the hub of the cut fan, then [i, i + max_verts - 1). i is
+ *   the last vertex of the window before, so the triangle across the cut is
+ *   drawn once.
+ * With restart, a window that holds a restart and does not reach the end of
+ * the draw ends at its last restart, the next one starts after it with no
+ * cut fan. The fans in it are drawn whole, each from its own hub. The count
+ * of a cut fan's window is scanned from i - 1, a vertex of that fan, which
+ * stands for its hub. Each window moves on by at least one position.
+ */
+KERNEL(FAN_WG)
+panlib_fan_chunk_step(global struct panlib_chunk_draw *c,
+                      global struct panlib_fan_chunk *f)
+{
+   local uint32_t tmp[4 * FAN_WG];
+   const uint32_t verts = c->in_draw[0], insts = c->in_draw[1];
+   const uint32_t inst = c->next_inst;
+   const uint32_t max_v = c->max_verts;
+   const bool restart = c->restart;
+   const bool live = verts && inst < insts && max_v >= 3;
+   const uint32_t hub = f->hub;
+   const bool cut = hub != PANLIB_FAN_NO_HUB;
+   uint32_t i = c->next_vertex;
+
+   /* Every invocation has read c and f: invocation 0 may write them from
+    * here on. */
+   barrier(CLK_GLOBAL_MEM_FENCE | CLK_LOCAL_MEM_FENCE);
+
+   uint32_t len = 0;
+   struct fan_scan sc = {UINT32_MAX, 0, 0};
+   if (live) {
+      if (verts <= max_v) {
+         if (restart)
+            sc = fan_scan(c, 0, verts, tmp);
+      } else {
+         while (restart && !cut && i < verts && fan_is_restart(c, i))
+            i++;
+         if (i < verts) {
+            len = min(cut ? max_v - 1 : max_v, verts - i);
+            if (restart)
+               sc = cut ? fan_scan(c, i - 1, len + 1, tmp)
+                        : fan_scan(c, i, len, tmp);
+         }
+      }
+   }
+
+   if (cl_local_id.x != 0)
+      return;
+
+   c->draw[0] = 0;
+   c->draw[1] = 0;
+   c->draw[2] = 0;
+   c->draw[3] = c->indexed ? c->in_draw[3] : c->in_draw[2];
+   c->draw[4] = c->indexed ? c->in_draw[4] : c->in_draw[3];
+   c->chunk_vertex = 0;
+   c->chunk_instance = 0;
+   c->more = 0;
+   f->c_count = 0;
+
+   if (!live) {
+      c->next_inst = insts;
+      return;
+   }
+
+   uint32_t n_insts = 1, count, prims;
+
+   if (verts <= max_v) {
+      n_insts = min(max(max_v / verts, 1u), insts - inst);
+      n_insts = min(n_insts, c->max_insts ? c->max_insts
+                                          : PANLIB_CHUNK_MAX_INSTANCES);
+      prims = restart ? sc.closed + u_decomposed_prims_for_vertices(
+                                       MESA_PRIM_TRIANGLE_FAN, sc.run)
+                      : u_decomposed_prims_for_vertices(
+                           MESA_PRIM_TRIANGLE_FAN, verts);
+      count = verts;
+      f->c_hub = 0;
+      f->c_first = 1;
+      f->hub = PANLIB_FAN_NO_HUB;
+      c->prim_base = 0;
+      c->prims_done = 0;
+      c->next_inst = inst + n_insts;
+      c->next_vertex = 0;
+   } else if (i >= verts) {
+      /* Only restart indices were left. */
+      f->hub = PANLIB_FAN_NO_HUB;
+      c->next_inst = inst + 1;
+      c->next_vertex = 0;
+      c->prims_done = 0;
+      c->more = c->next_inst < insts;
+      return;
+   } else {
+      const bool end = i + len >= verts;
+      uint32_t next;
+
+      f->c_hub = cut ? hub : i;
+      f->c_first = cut ? i : i + 1;
+
+      if (restart && sc.last != UINT32_MAX && !end) {
+         /* Draw the fans up to the last restart whole. */
+         count = sc.last - i + (cut ? 1 : 0);
+         prims = sc.closed;
+         next = sc.last + 1;
+         f->hub = PANLIB_FAN_NO_HUB;
+      } else {
+         count = len + (cut ? 1 : 0);
+         prims = restart ? sc.closed + u_decomposed_prims_for_vertices(
+                                          MESA_PRIM_TRIANGLE_FAN, sc.run)
+                         : u_decomposed_prims_for_vertices(
+                              MESA_PRIM_TRIANGLE_FAN, count);
+         next = i + len - 1;
+         f->hub = f->c_hub;
+      }
+
+      c->prim_base = c->prims_done;
+      c->prims_done += prims;
+      c->next_vertex = next;
+      if (end || next >= verts) {
+         f->hub = PANLIB_FAN_NO_HUB;
+         c->next_inst = inst + 1;
+         c->next_vertex = 0;
+         c->prims_done = 0;
+      }
+   }
+
+   f->c_count = count;
+   c->draw[0] = count;
+   c->draw[1] = n_insts;
+   c->chunk_instance = inst;
+   c->more = c->next_inst < insts;
+
+   if (c->prims_generated) {
+      atomic_fetch_add((global atomic_uint *)(uintptr_t)c->prims_generated,
+                       prims * n_insts * c->view_count);
+   }
+}
+
+/* The chunk panlib_fan_chunk_step() planned, as 32-bit indices. Without an
+ * index buffer the positions are the indices (the chunk's vertexOffset is
+ * firstVertex). Restart indices become 0xffffffff.
+ */
+KERNEL(64)
+panlib_fan_chunk_fill(global struct panlib_chunk_draw *c,
+                      global struct panlib_fan_chunk *f)
+{
+   const uint32_t j = cl_global_id.x;
+
+   if (j >= f->c_count)
+      return;
+
+   const uint32_t pos = j ? f->c_first + j - 1 : f->c_hub;
+   global uint32_t *dst = (global uint32_t *)(uintptr_t)f->indices;
+
+   if (!c->indexed) {
+      dst[j] = pos;
+      return;
+   }
+
+   bool restart;
+   uint32_t v = fan_index(c, pos, &restart);
+   dst[j] = restart ? 0xffffffff : v;
+}
+
+/* An indirect fan lowered in one pass (not chunked): clamps its counts to
+ * what the arena holds, so the triangles past it are dropped instead of
+ * drawn from stale records and indices. The words are the lowered VS
+ * params (vertex count, instance count, vertices per instance), its
+ * dispatch grid and the generated draw.
+ */
+KERNEL(1)
+panlib_fan_clamp_draw(global uint32_t *vertex_count,
+                      global uint32_t *instance_count,
+                      global uint32_t *verts_per_instance,
+                      global uint32_t *dispatch, global uint32_t *gen_draw,
+                      uint32_t cap)
+{
+   uint32_t n = *vertex_count, k = *instance_count;
+
+   if ((uint64_t)n * k <= cap)
+      return;
+
+   n = min(n, cap);
+   k = min(k, cap / n);
+
+   *vertex_count = n;
+   *instance_count = k;
+   *verts_per_instance = n;
+   dispatch[0] = n;
+   dispatch[1] = k;
+   gen_draw[0] = n;
+   gen_draw[1] = k;
+}
+
+#endif
+
+#if PAN_ARCH == 9
+
+/* jm-v7 119: the v9 JM form of panlib_fan_clamp_draw(). An indirect fan is
+ * lowered in one pass (no GPU chunk loop on JM) and
+ * panlib_v9_prerast_indirect() makes a draw over the record capacity NULL
+ * jobs, so a fan over the arena drew nothing while the primitives generated
+ * query counted all of it. This copies the VkDraw(Indexed)IndirectCommand
+ * (words: 4 or 5) to dst, with vertices x instances clamped to cap as CSF
+ * does, so the first triangles are drawn and the rest is dropped. Every
+ * consumer of the draw (queries, lowering) then reads dst.
+ */
+KERNEL(1)
+panlib_v9_fan_clamp_cmd(global uint32_t *dst, global const uint32_t *src,
+                        uint32_t words, uint32_t cap)
+{
+   for (uint32_t i = 0; i < words; i++)
+      dst[i] = src[i];
+
+   uint32_t n = src[0], k = src[1];
+   if ((uint64_t)n * k <= cap)
+      return;
+
+   n = min(n, cap);
+   k = min(k, cap / n);
+   dst[0] = n;
+   dst[1] = k;
+}
+
+#endif
diff --git a/src/panfrost/libpan/fan_chunks.h b/src/panfrost/libpan/fan_chunks.h
new file mode 100644
index 00000000000..169b8a038bc
--- /dev/null
+++ b/src/panfrost/libpan/fan_chunks.h
@@ -0,0 +1,32 @@
+/*
+ * Copyright 2026 Abhay Byte
+ * SPDX-License-Identifier: MIT
+ */
+
+#pragma once
+
+#include "compiler/libcl/libcl.h"
+
+/* Triangle fans in the gpu_prerast chunk loop (v10+ CSF), next to the
+ * struct panlib_chunk_draw of the draw, see fan_chunks.cl.
+ *
+ * Each chunk is an indexed fan of 32-bit indices in a per-draw buffer of
+ * max_verts + 1 entries: the hub, then a window of API vertices. A window
+ * that cuts a fan keeps its hub for the next window, which starts on the
+ * window's last vertex, so every API triangle is drawn once with its own
+ * vertices, winding and primitive ID.
+ */
+#define PANLIB_FAN_NO_HUB 0xffffffffu
+
+struct panlib_fan_chunk {
+   /* Chunk index buffer, max_verts + 1 uint32_t. */
+   uint64_t indices;
+   /* Position of the hub of the fan the last window cut, else
+    * PANLIB_FAN_NO_HUB. Positions count from firstIndex (indexed) or 0. */
+   uint32_t hub;
+   /* The current chunk: index 0 is position c_hub, index j > 0 is
+    * position c_first + j - 1, c_count indices. */
+   uint32_t c_hub;
+   uint32_t c_first;
+   uint32_t c_count;
+} PACKED;
