+uvec4 interpolate_endpoint(DecodedInterpolation interp)
+{
+    uvec3 rgb = (((64u - interp.color_weight) * interp.ep0.rgb + interp.color_weight * interp.ep1.rgb + 32) >> 6);
+    uint a = (((64u - interp.alpha_weight) * interp.ep0.a + interp.alpha_weight * interp.ep1.a + 32) >> 6);
+    uvec4 rgba = uvec4(rgb, a);
+
+    switch (interp.rotation)
+    {
+        default:
+        break;
+        case 1u:
+        rgba = rgba.agbr;
+        break;
+        case 2u:
+        rgba = rgba.rabg;
+        break;
+        case 3u:
+        rgba = rgba.rgab;
+        break;
+    }
+
+    return rgba;
+}
+
+#ifdef PANVK_BC_FAST
+/* interpolate_endpoint() in fp32 (exact: every term is an integer below
+ * 2^24), as the colour: on Valhall the integer form keeps the CVT unit busy
+ * while the FMA unit idles. */
+vec4 bc7f_color(DecodedInterpolation interp)
+{
+    vec4 e0 = vec4(interp.ep0), e1 = vec4(interp.ep1);
+    vec4 w = vec4(vec3(float(interp.color_weight)), float(interp.alpha_weight));
+    vec4 c = floor((e0 * 64.0 + (e1 - e0) * w + 32.0) * (1.0 / 64.0));
+
+    switch (interp.rotation)
+    {
+        default:
+        break;
+        case 1u:
+        c = c.agbr;
+        break;
+        case 2u:
+        c = c.rabg;
+        break;
+        case 3u:
+        c = c.rgab;
+        break;
+    }
+
+    return c * (1.0 / 255.0);
+}
+#endif
