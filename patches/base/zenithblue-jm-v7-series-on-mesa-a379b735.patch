+   panvk_unmerge_cull_var(nir, nir_var_shader_in);
+   /* TCS outputs stay merged: the TES reads them the same way. */
+   if (nir->info.stage == MESA_SHADER_GEOMETRY)
+      panvk_unmerge_cull_var(nir, nir_var_shader_out);
+}
