+
+   PANVK_KBASE_PROGRESS_COMPUTE_ENTER = 1<<1,
+   PANVK_KBASE_PROGRESS_COMPUTE_BEFORE_ITER = 1<<2,
+   PANVK_KBASE_PROGRESS_COMPUTE_BEFORE_RUN = 1<<3,
