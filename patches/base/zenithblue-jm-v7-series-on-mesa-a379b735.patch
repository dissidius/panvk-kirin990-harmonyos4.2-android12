+       * csf-v11/217: BC2/BC3 colour too. 0x1020000 is the bc6 encoder,
+       * 0x20000 the bc4 one, 0xc30000 the bc3 one. */
+      opts = s ? (int64_t)(strtoul(s, NULL, 0) & 0xffffffffu) : 0x3020000;
+   }
