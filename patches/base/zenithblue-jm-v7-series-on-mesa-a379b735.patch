+   for (uint32_t i = 0; i < PANLIB_XFB_MAX_BUFFERS; i++) {
+      uint64_t counter =
+         xfb_counter_addr(i, firstCounterBuffer, counterBufferCount,
+                          pCounterBuffers, pCounterBufferOffsets);
