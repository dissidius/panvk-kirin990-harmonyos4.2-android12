+/* kbase has no DRM syncobjs: panvk uses its own CPU sync type on kbase
+ * (get_device_sync_types_kbase()), so every operation of this provider
+ * fails with ENOSYS. pan_kmod_dev_init() requires a provider. */
+static int
+kbase_sync_unsupported(void)
+{
+   errno = ENOSYS;
+   return -1;
+}
+
+#define KBASE_SYNC_STUB(name, ...)                                             \
+   static int kbase_sync_##name(UNUSED struct util_sync_provider *p,          \
+                                __VA_ARGS__)                                   \
+   {                                                                           \
+      return kbase_sync_unsupported();                                        \
+   }
+
+KBASE_SYNC_STUB(create, UNUSED uint32_t flags, UNUSED uint32_t *handle)
+KBASE_SYNC_STUB(destroy, UNUSED uint32_t handle)
+KBASE_SYNC_STUB(handle_to_fd, UNUSED uint32_t handle, UNUSED int *fd)
+KBASE_SYNC_STUB(fd_to_handle, UNUSED int fd, UNUSED uint32_t *handle)
+KBASE_SYNC_STUB(import_sync_file, UNUSED uint32_t handle, UNUSED int fd)
+KBASE_SYNC_STUB(export_sync_file, UNUSED uint32_t handle, UNUSED int *fd)
+KBASE_SYNC_STUB(wait, UNUSED uint32_t *handles, UNUSED unsigned n,
+                UNUSED int64_t timeout, UNUSED unsigned flags,
+                UNUSED uint32_t *first)
+KBASE_SYNC_STUB(reset, UNUSED const uint32_t *handles, UNUSED uint32_t n)
+KBASE_SYNC_STUB(signal, UNUSED const uint32_t *handles, UNUSED uint32_t n)
+KBASE_SYNC_STUB(timeline_signal, UNUSED const uint32_t *handles,
+                UNUSED uint64_t *points, UNUSED uint32_t n)
+KBASE_SYNC_STUB(timeline_wait, UNUSED uint32_t *handles,
+                UNUSED uint64_t *points, UNUSED unsigned n,
+                UNUSED int64_t timeout, UNUSED unsigned flags,
+                UNUSED uint32_t *first)
+KBASE_SYNC_STUB(query, UNUSED uint32_t *handles, UNUSED uint64_t *points,
+                UNUSED uint32_t n, UNUSED uint32_t flags)
+KBASE_SYNC_STUB(transfer, UNUSED uint32_t dst, UNUSED uint64_t dst_point,
+                UNUSED uint32_t src, UNUSED uint64_t src_point,
+                UNUSED uint32_t flags)
+
+static void
+kbase_sync_finalize(UNUSED struct util_sync_provider *p)
+{
+}
+
+static struct util_sync_provider *
+kbase_sync_clone(struct util_sync_provider *p)
+{
+   return p;
+}
+
+static struct util_sync_provider kbase_sync_provider = {
+   .create = kbase_sync_create,
+   .destroy = kbase_sync_destroy,
+   .handle_to_fd = kbase_sync_handle_to_fd,
+   .fd_to_handle = kbase_sync_fd_to_handle,
+   .import_sync_file = kbase_sync_import_sync_file,
+   .export_sync_file = kbase_sync_export_sync_file,
+   .wait = kbase_sync_wait,
+   .reset = kbase_sync_reset,
+   .signal = kbase_sync_signal,
+   .timeline_signal = kbase_sync_timeline_signal,
+   .timeline_wait = kbase_sync_timeline_wait,
+   .query = kbase_sync_query,
+   .transfer = kbase_sync_transfer,
+   .finalize = kbase_sync_finalize,
+   .clone = kbase_sync_clone,
+};
