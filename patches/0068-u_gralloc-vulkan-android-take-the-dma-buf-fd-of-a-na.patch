From eec3ddd39a0f0c27a9aebfaf3ed0655d33231ea0 Mon Sep 17 00:00:00 2001
From: soulexit <metehan.tanriverdi01@gmail.com>
Date: Tue, 10 Nov 2026 23:04:10 +0300
Subject: [PATCH 68/69] u_gralloc, vulkan/android: take the dma-buf fd of a
 native handle

Not every gralloc puts the buffer's dma-buf in data[0]: MediaTek's
gralloc4 (Helio G80, Vivo V21s) puts an anon_inode:gralloc_extra
metadata file there and the dma-buf in data[1]. Swapchain images
(vk_android_import_anb_memory) and the fallback gralloc's guessed
linear layout imported data[0], so GetMemoryFdPropertiesKHR failed and
Winlator's renderer showed a black screen with PanVK.

u_gralloc_get_dmabuf_fd() returns the first fd of the handle whose
/proc/self/fd link is a dma-buf, else data[0].

Tested: Winlator renderer on the Vivo draws with this driver.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/util/u_gralloc/u_gralloc.c          | 28 +++++++++++++++++++++++++
 src/util/u_gralloc/u_gralloc.h          |  3 +++
 src/util/u_gralloc/u_gralloc_fallback.c |  2 +-
 src/vulkan/runtime/vk_android.c         |  2 +-
 4 files changed, 33 insertions(+), 2 deletions(-)

diff --git a/src/util/u_gralloc/u_gralloc.c b/src/util/u_gralloc/u_gralloc.c
index 960986fb89e..4eaa4e8a451 100644
--- a/src/util/u_gralloc/u_gralloc.c
+++ b/src/util/u_gralloc/u_gralloc.c
@@ -9,6 +9,9 @@
 
 #include <assert.h>
 #include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
 
 #include "drm-uapi/drm_fourcc.h"
 #include "util/log.h"
@@ -154,3 +157,28 @@ u_gralloc_get_type(struct u_gralloc *gralloc)
 {
    return gralloc->type;
 }
+
+/* The native handle fd that holds the pixels. Most gralloc implementations
+ * put the buffer's dma-buf in data[0], but MediaTek's (gralloc4 on Helio
+ * G80) puts an anon_inode:gralloc_extra metadata file there and the dma-buf
+ * in data[1]; importing data[0] fails. Returns the first fd that is a
+ * dma-buf, else data[0] (-1 for a handle without fds). */
+int
+u_gralloc_get_dmabuf_fd(const native_handle_t *handle)
+{
+   if (!handle || handle->numFds <= 0)
+      return -1;
+
+   for (int i = 0; i < handle->numFds; i++) {
+      char path[64], link[64];
+      snprintf(path, sizeof(path), "/proc/self/fd/%d", handle->data[i]);
+      ssize_t n = readlink(path, link, sizeof(link) - 1);
+      if (n <= 0)
+         continue;
+      link[n] = 0;
+      if (!strncmp(link, "/dmabuf", 7) ||
+          !strncmp(link, "anon_inode:dmabuf", 17))
+         return handle->data[i];
+   }
+   return handle->data[0];
+}
diff --git a/src/util/u_gralloc/u_gralloc.h b/src/util/u_gralloc/u_gralloc.h
index 2b93db1498b..ba28191394a 100644
--- a/src/util/u_gralloc/u_gralloc.h
+++ b/src/util/u_gralloc/u_gralloc.h
@@ -80,6 +80,9 @@ int u_gralloc_get_front_rendering_usage(struct u_gralloc *gralloc,
 
 int u_gralloc_get_type(struct u_gralloc *gralloc);
 
+/* The dma-buf fd of a native handle (not always data[0]). */
+int u_gralloc_get_dmabuf_fd(const native_handle_t *handle);
+
 #ifdef __cplusplus
 }
 #endif
diff --git a/src/util/u_gralloc/u_gralloc_fallback.c b/src/util/u_gralloc/u_gralloc_fallback.c
index 37b0438a0af..f675f221c39 100644
--- a/src/util/u_gralloc/u_gralloc_fallback.c
+++ b/src/util/u_gralloc/u_gralloc_fallback.c
@@ -700,7 +700,7 @@ fallback_gralloc_get_buffer_info(struct u_gralloc *gralloc,
          out->drm_fourcc = drm_fourcc;
          out->modifier = DRM_FORMAT_MOD_LINEAR;
          out->num_planes = 1;
-         out->fds[0] = hnd->handle->data[0];
+         out->fds[0] = u_gralloc_get_dmabuf_fd(hnd->handle);
          out->offsets[0] = 0;
          out->strides[0] = stride;
          return 0;
diff --git a/src/vulkan/runtime/vk_android.c b/src/vulkan/runtime/vk_android.c
index fa56cd88f39..bb65e5da53f 100644
--- a/src/vulkan/runtime/vk_android.c
+++ b/src/vulkan/runtime/vk_android.c
@@ -220,7 +220,7 @@ vk_android_import_anb_memory(struct vk_device *device,
 {
    assert(anb && anb->handle && anb->handle->numFds > 0);
 
-   int dma_buf_fd = anb->handle->data[0];
+   int dma_buf_fd = u_gralloc_get_dmabuf_fd(anb->handle);
 
    /* Query image memory requirements for size and supported memory types */
    VkMemoryRequirements mem_reqs;
-- 
